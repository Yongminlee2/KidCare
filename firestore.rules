rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 이 사용자가 해당 가족의 멤버인가
    function memberOf(familyId) {
      return signedIn() && exists(
        /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)
      );
    }

    function roleIn(familyId) {
      return get(
        /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)
      ).data.role;
    }

    // 코드를 아는 것 자체가 열쇠다. families 를 inviteCode 필드로 query(whereEqualTo)
    // 하게 열어두면, Firestore 규칙에서 read 는 get 과 list 를 구분하지 않으므로
    // read 를 여는 순간 회원이 아닌 사람도 families 컬렉션 전체를 list 해서 모든
    // 초대 코드를 긁어갈 수 있었다(Task 6 보안 리뷰 Critical 1 — "목록 조회만
    // 열었다"던 예전 주석은 틀렸다). 그래서 코드를 문서 ID 로 쓰는 이 별도
    // 컬렉션을 두고, get(정확한 ID로 한 건)만 허용하고 list 는 아예 금지한다.
    match /inviteCodes/{code} {
      allow get: if signedIn();            // 코드를 정확히 알아야 읽는다
      allow list: if false;                // 목록 조회 금지 — 코드 수집 차단
      allow create: if signedIn()
                    && memberOf(request.resource.data.familyId)
                    && roleIn(request.resource.data.familyId) == 'guardian';
      // update 는 보호자만 — familyId 도 못 바꾼다. 막는 공격: 아무 멤버가 update
      // 로 familyId 를 다른 가족으로 갈아치우거나(문서를 가로채 다른 가족의 초대
      // 창구로 재사용) expiresAt 을 조작해 코드를 되살리는 것 (fix round 2 Important 3).
      allow update: if signedIn()
                    && memberOf(resource.data.familyId)
                    && roleIn(resource.data.familyId) == 'guardian'
                    && request.resource.data.familyId == resource.data.familyId;
      // delete 는 그대로 아무 멤버나 — 아이가 join 직후 자기가 쓴 코드를 죽여야
      // 하기 때문이다(joinFamily). 대가: 멤버라면 자기 가족의 살아있는 코드
      // 문서를 실수로/악의로 미리 지워 페어링을 막을 수 있다(자기 가족限定 자해성
      // 서비스 거부). 보호자가 inviteCodeOf 로 다시 발급하면 복구되므로 허용한다.
      allow delete: if signedIn() && memberOf(resource.data.familyId);
    }

    match /families/{familyId} {
      // families 문서도 list 를 막는다. 목록 조회를 열면 문서 내용이(예전엔
      // inviteCode 필드까지) 회원이 아닌 사람에게 그대로 노출된다. get 은 멤버만.
      allow get: if memberOf(familyId);
      allow list: if false;
      // 가족을 만드는 사람은 자기 uid 를 ownerUid 로 적어야 한다.
      // (아래 members/{보호자uid} 를 create 할 때 이 값을 대조한다.)
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      // update 를 역할별로 쪼갠다. 막는 공격: 예전엔 "멤버이기만 하면" 저 세
      // 필드를 아무 값으로나 바꿀 수 있어서, 자녀 멤버가 inviteCode 를 자기가
      // 원하는 값으로, inviteExpiresAt 을 먼 미래로 설정해 스스로 상시 초대장을
      // 만들어 외부인을 가족에 끌어들일 수 있었다(fix round 2 Critical 2).
      allow update: if memberOf(familyId) && (
          // 보호자: 코드 재발급과 이름 변경.
          (roleIn(familyId) == 'guardian'
           && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['inviteCode', 'inviteExpiresAt', 'name']))
          ||
          // 아무 멤버나 할 수 있는 것은 "가입 직후 코드를 죽이는 것" 하나뿐이다.
          // 0 으로 내리는 것만 허용하고 미래로 늘리는 길은 막는다 — joinFamily 가
          // 자녀 자격으로 이 쓰기를 해야 하므로 보호자 전용으로 막을 수는 없다.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteExpiresAt'])
           && request.resource.data.inviteExpiresAt == 0)
      );
      allow delete: if false;

      match /members/{uid} {
        allow read: if memberOf(familyId);
        // 자기 자신의 멤버 문서만 만들 수 있고, 그마저도 두 경우만 허용한다:
        //   1) 가족을 만든 본인이 보호자 자리를 가져간다 (ownerUid 대조)
        //   2) 살아있는 초대 코드를 실제로 아는 사람이 자녀 자리를 가져간다
        //      (요청이 실어보낸 joinCode 가 families.inviteCode 와 같고,
        //       아직 만료 전이어야 한다)
        // joinFamily() 의 클라이언트 쪽 검사(코드 존재·만료·중복)는 클라이언트가
        // 스스로 지키겠다는 약속일 뿐 강제력이 없다 — 실제로 강제하는 곳은 여기다.
        allow create: if signedIn() && request.auth.uid == uid && (
            (request.resource.data.role == 'guardian'
             && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid)
            ||
            (request.resource.data.role == 'child'
             && request.resource.data.joinCode
                  == get(/databases/$(database)/documents/families/$(familyId)).data.inviteCode
             && get(/databases/$(database)/documents/families/$(familyId)).data.inviteExpiresAt
                  > request.time.toMillis())
        );
        // role·joinCode 는 생성 이후 불변이다. 막는 공격: 예전엔 자기 문서라면
        // 아무 필드나 바꿀 수 있어서, 이미 join 한 자녀가 자기 role 을 'guardian'
        // 으로 고쳐 roleIn() 을 속이고 places/schedules 쓰기, events 삭제, 심지어
        // 진짜 보호자의 members 문서 delete(= 가족에서 추방)까지 손에 넣을 수
        // 있었다(fix round 2 Critical 1). 아이도 이 앱의 API 키로 Firestore 를
        // 직접 두드릴 수 있는 잠재적 공격자라고 가정한다.
        allow update: if signedIn() && request.auth.uid == uid
                      && request.resource.data.role == resource.data.role
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['displayName', 'fcmToken', 'appVersion', 'updatedAt']);
        allow delete: if memberOf(familyId) && roleIn(familyId) == 'guardian';
      }

      // 재귀 와일드카드(/{document=**})를 쓰지 않고 하위 컬렉션을 하나씩 적는다.
      // 이유: 규칙은 OR 로 평가되므로 와일드카드를 남겨둔 채 commands 규칙만 더하면
      // 아이도 계속 commands 에 쓸 수 있다. 그러면 아이가 자기 폰에 set_ringer(normal)
      // 명령을 스스로 넣어 무음 예약을 무력화할 수 있다 — 이 앱의 위협 모델에는
      // 아이 본인이 들어 있다.
      match /children/{childUid} {
        // 이 문서 자체가 status(현재 위치·배터리·현재 모드)다. 아이만 쓴다.
        allow read: if memberOf(familyId);
        allow write: if memberOf(familyId) && request.auth.uid == childUid;

        // 하루가 문서 하나다(문서 ID 가 dayKey, 예: "2026-08-07"). 그 안에 그 날의
        // 원시 점 배열과 구간 요약 배열이 함께 들어 있다.
        //
        // 옛 points/{pointId} 와 segments/{segmentId} 를 **둘 다** 이걸로 대체했다.
        // 방향과 조건은 그대로다(아이만 쓰고 가족 멤버는 읽는다) — 바뀐 것은 문서
        // 개수뿐이다. 옛 구조는 점 하나마다 문서 하나(하루 약 520개)에 구간 하루치
        // 교체(20~30 삭제 + 20~30 쓰기)라 가족 하나가 하루 1,100번을 썼고, Spark
        // 무료 한도(프로젝트 전체 하루 2만 쓰기)에서 1,000가족을 담을 수 없었다.
        //
        // 두 옛 컬렉션 규칙은 지웠다. 앱 어디에서도 더 이상 읽지도 쓰지도 않으므로
        // 남겨두면 "아무도 안 쓰는데 아이가 쓸 수는 있는" 경로만 남는다. 이미 올라가
        // 있는 옛 문서는 그대로 남지만 아무도 못 읽는다 — 테스트 단계 데이터라
        // 버리기로 했다(docs/known-issues.md 12번).
        match /trails/{dayKey} {
          allow read: if memberOf(familyId);
          allow write: if memberOf(familyId) && request.auth.uid == childUid;
        }

        // 명령은 방향이 반대다: 보호자가 만들고 아이가 실행 결과만 적는다.
        match /commands/{commandId} {
          allow read: if memberOf(familyId);
          // 만드는 것은 보호자만. 항상 pending 으로 시작해야 한다 — 보호자가 처음부터
          // done 으로 위조해서 만드는 것은 여기서 막는다. (생성 시점 한정: 만들어진
          // 뒤에 아이가 done 으로 "도달"하는 경로를 막는 건 이 규칙이 아니라 아래
          // update 의 상태 전이 제약이 맡는다 — 여기서 다 막는다고 착각하지 말 것.)
          allow create: if memberOf(familyId)
                        && roleIn(familyId) == 'guardian'
                        && request.resource.data.state == 'pending';
          // 아이는 진행 상태만 갱신한다. type·payload 를 바꿀 수 없으므로
          // "받은 명령을 다른 명령으로 바꿔치기"가 불가능하다.
          // state 전이는 앞으로만 허용한다: pending→delivered/failed,
          // delivered→done/failed. done·failed 는 종료 상태라 그 이후로는 state 를
          // 포함한 어떤 update 도 통과하지 않는다(문서가 사실상 잠긴다). 이게 없으면
          // 아이가 pending 을 곧장 done 으로 바꿔 "실행하지 않고 완료로 위장"할 수
          // 있었다 — delete 를 막아도 done 으로 덮어써 버리면 사실상 명령을 지운
          // 것과 같은 효과였다.
          // 이 제약도 "폰이 실제로 울렸는지"까지는 검증하지 못한다. 아이가
          // pending→delivered→done 순서만 지키면 여전히 아무것도 실행하지 않고
          // 종료 상태에 도달할 수 있다 — 이건 규칙으로 막을 수 있는 범위 밖이라
          // docs/known-issues.md(남겨두기로 판단한 것)에 남겨뒀다.
          allow update: if memberOf(familyId)
                        && request.auth.uid == childUid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['state', 'deliveredAt', 'doneAt', 'error'])
                        && (
                             (resource.data.state == 'pending'
                              && request.resource.data.state in ['delivered', 'failed'])
                             ||
                             (resource.data.state == 'delivered'
                              && request.resource.data.state in ['done', 'failed'])
                        );
          // 오래된 명령 정리는 보호자 몫.
          allow delete: if memberOf(familyId) && roleIn(familyId) == 'guardian';
        }
      }

      // "아이가 되돌리면 다시 바꾸기" 같은 가족 단위 설정. 보호자가 정하고 아이는 읽는다.
      // families 문서에 필드를 더하지 않는 이유: 그 문서의 update 규칙은
      // hasOnly(['inviteCode','inviteExpiresAt','name']) 로 잠겨 있어 새 필드를 못 쓴다.
      match /settings/{settingId} {
        allow read: if memberOf(familyId);
        allow write: if memberOf(familyId) && roleIn(familyId) == 'guardian';
      }

      // 장소는 부모가 정한다. 아이는 읽기만 — 자기 폰에 지오펜스를 걸려면 좌표와
      // 반경을 알아야 하기 때문이다. 쓰기를 열면 아이가 학교 반경을 0 으로 만들거나
      // 장소 문서를 통째로 지워서 도착 알림 자체를 없앨 수 있다. write 한 줄이
      // create·update·delete 세 갈래를 다 덮으므로 빠지는 길이 없다.
      // 이 조건은 roleIn 이 정직하다는 것에 기대고 있다 — 아이가 자기 role 을
      // 'guardian' 으로 고치는 길은 위 members update 의 role 불변 규칙이 막는다.
      // 그 규칙이 무너지면 이 줄도 같이 무너진다(fix round 2 Critical 1 참고).
      match /places/{id} {
        allow read: if memberOf(familyId);
        allow write: if memberOf(familyId) && roleIn(familyId) == 'guardian';
      }

      match /schedules/{id} {
        allow read: if memberOf(familyId);
        allow write: if memberOf(familyId) && roleIn(familyId) == 'guardian';
      }

      // 이벤트는 방향이 반대다: 아이 폰이 만들고 부모가 읽는다.
      //
      // 5단계에서 조였다. 옛 규칙은 create 가 `memberOf` 하나뿐이라 아이가 남의
      // 이름으로 사건을 지어내거나, 만들면서 read: true 로 적어 부모의 안 읽은
      // 목록에 아예 안 뜨게 할 수 있었다. **조인 블록을 옆에 덧붙이지 않고 이
      // 블록 자체를 고쳤다** — 규칙은 OR 로 평가되므로 헐거운 옛 블록을 남겨두면
      // 새 블록을 아무리 조여도 옛 블록 하나로 전부 통과한다. 재귀 와일드카드를
      // 지웠던 것(위 children 주석)과 같은 함정이고, 같은 이유로 여기도 컬렉션을
      // 하나씩 적는다.
      match /events/{id} {
        allow read: if memberOf(familyId);
        // 만드는 것은 그 아이 본인만. childUid 를 자기 uid 로 적게 강제해 남의
        // 이름으로 사건을 지어내지 못하게 한다. read 는 항상 false 로 시작해야
        // 한다 — 아이가 만들면서 미리 읽음 표시를 해 두면 부모 화면에서 사라진다.
        //
        // at 은 서버 시각(request.time) 기준으로 창을 둔다. 도착 기록의 at 을
        // 한참 과거로 적으면 부모의 최신순 목록 아래로 가라앉아 사실상 안 알린
        // 것이 된다. 폰 시계를 되돌려도 결과가 같으므로 폰 시계가 아니라 서버
        // 시각으로 잰다. 창을 넉넉히 잡은 이유가 있다: 규칙이 거부하면 그 이벤트는
        // 부모에게 영영 안 간다. 조이다가 정직한 늦은 쓰기까지 막으면 그것 자체가
        // 우리가 막으려던 "조용한 실패"가 된다.
        //   과거 7일   — 폰이 오프라인이라 쓰기가 큐에 밀렸다 늦게 올라오는 경우
        //   미래 1시간 — 폰 시계가 조금 빠른 경우
        //
        // 과거 창을 24시간에서 7일로 넓혔다(6단계). 24시간이던 시절에는 아이 폰이
        // 하루 넘게 오프라인이면 그 사이 쌓인 도착·이탈·배터리 이벤트가 서버에
        // 닿는 순간 통째로 거부돼 **부모에게 영영 안 갔다.** 지도의 경로(trails 는
        // 시각 창이 없다)는 남는데 알림만 사라져서, 화면만 봐서는 조용한 하루와
        // 구분되지 않았다 — 이 앱에서 제일 위험한 종류의 실패다.
        //
        // 24시간이었던 원래 근거는 "부모 폰이 at 으로 필터링하면 늦은 이벤트가
        // 리스너에 아예 안 잡힌다"였는데, 실제 구현(AlertService)은 at 으로
        // 필터링하지 않고 이미 알린 문서 id 집합으로 거른다. 그래서 그 근거는
        // 이 코드에는 해당되지 않는다.
        //
        // 하한을 아예 없애지는 않는다. at 을 0 으로 적으면 최신순 목록 맨 아래로
        // 가라앉아 사실상 안 알린 것이 되기 때문이다. 7일보다 오래 꺼져 있던 폰은
        // 이벤트가 아니라 연결 끊김 배너가 다룰 일이다.
        //
        // type 은 일부러 안 묶는다. 값 목록으로 잠그면 이벤트 종류가 하나 늘 때마다
        // 사람이 콘솔에 규칙을 다시 게시해야 하고, 잊으면 그 종류만 조용히
        // PERMISSION_DENIED 로 죽는다(docs/setup.md 의 게시 순서 참고). 반면 막아서
        // 얻는 것은 낯선 type 이 목록에 한 줄 이상하게 보이는 정도다 — 알림을
        // 없애지는 못한다. 값이 비싸지 않아서 안 산다.
        //
        // 여기에 roleIn 을 걸지 않은 것도 일부러다. roleIn 은 get() 이라 읽기가 한
        // 번 더 붙는데, 이벤트 생성은 이 컬렉션에서 제일 잦은 쓰기다. childUid 대조
        // 만으로 "아무나 남의 이름으로" 는 이미 막힌다.
        allow create: if memberOf(familyId)
                      && request.resource.data.childUid == request.auth.uid
                      && request.resource.data.read == false
                      && request.resource.data.at > request.time.toMillis() - 7 * 24 * 60 * 60 * 1000
                      && request.resource.data.at < request.time.toMillis() + 60 * 60 * 1000;
        // 읽음 표시는 부모만, 그리고 read 필드 하나만. 막는 공격 둘: 아이가 자기
        // 도착 기록의 placeName·at 을 사후에 고치는 것과, 아이가 자기 이벤트를
        // 스스로 읽음 처리해 부모의 안 읽은 목록에서 지워버리는 것. 후자 때문에
        // 여기서는 읽기 한 번(get)을 더 내고서라도 보호자를 확인한다.
        allow update: if memberOf(familyId)
                      && roleIn(familyId) == 'guardian'
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['read']);
        // 지우는 것도 부모만. 아이가 자기 이탈 기록을 지우면 알림의 뜻이 없다.
        allow delete: if memberOf(familyId) && roleIn(familyId) == 'guardian';
      }
    }
  }
}
