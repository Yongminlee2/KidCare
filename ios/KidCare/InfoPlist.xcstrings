    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sends your location so your parents can see where you are. It has to keep sending while the screen is off so they can find you if you get lost."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends your location so your parents can see where you are. It has to keep sending while the screen is off so they can find you if you get lost."
