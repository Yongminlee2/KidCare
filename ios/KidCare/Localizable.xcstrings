    "leave_family_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Elternverbindung dieses Handys und sein anonymes Konto werden gelöscht. Aufzeichnungen, Zeitpläne und Orte deines Kindes bleiben in der Familie. Um sie wieder zu sehen, brauchst du einen neuen Einladungscode."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes this phone's parent link and its anonymous account. Your child's records, schedules and places stay with the family. To see them again, you'll need a new invite code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán el vínculo de padre de este teléfono y su cuenta anónima. Los registros, horarios y lugares de tu hijo se quedan en la familia. Para volver a verlos necesitarás un nuevo código de invitación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien parent de ce téléphone et son compte anonyme seront supprimés. Les historiques, horaires et lieux de votre enfant restent dans la famille. Pour les revoir, il faudra un nouveau code d'invitation."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan orang tua dan akun anonim ponsel ini akan dihapus. Catatan, jadwal, dan tempat anak tetap ada di keluarga. Untuk melihatnya lagi, Anda perlu kode undangan baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno eliminati il collegamento da genitore di questo telefono e il suo account anonimo. I registri, le programmazioni e i luoghi di tuo figlio restano nella famiglia. Per rivederli ti servirà un nuovo codice di invito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマホの保護者としての連携と匿名アカウントを削除します。お子さんの記録や予約・場所は家族にそのまま残ります。もう一度見るには新しい招待コードが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폰의 보호자 연결과 익명 계정을 지워요. 아이 폰의 기록과 예약·장소는 가족에 그대로 남아요. 다시 보려면 새 초대 번호를 받아야 해요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O vínculo de responsável deste telefone e sua conta anônima serão apagados. Os registros, horários e lugares da criança continuam na família. Para vê-los de novo, você precisará de um novo código de convite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связь этого телефона как родителя и его анонимный аккаунт будут удалены. Записи, расписания и места ребёнка останутся в семье. Чтобы снова их видеть, понадобится новый код приглашения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะลบการเชื่อมต่อผู้ปกครองและบัญชีไม่ระบุตัวตนของโทรศัพท์เครื่องนี้ บันทึก ตารางเวลา และสถานที่ของลูกยังอยู่ในครอบครัวเหมือนเดิม หากต้องการดูอีกครั้งต้องใช้รหัสเชิญใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết phụ huynh và tài khoản ẩn danh của điện thoại này sẽ bị xóa. Lịch sử, lịch hẹn và địa điểm của con vẫn ở lại trong gia đình. Để xem lại, bạn cần mã mời mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除此手机的家长连接和匿名账号。孩子的记录、预约和地点会保留在家庭中。如需再次查看，需要新的邀请码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除此手機的家長連結和匿名帳號。孩子的紀錄、預約和地點會保留在家庭中。如需再次查看，需要新的邀請碼。"
          }
        }
      }
    },
    "leave_family_no_account": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung dieses Handys wurde nicht gefunden, daher konnte es auf dem Server nicht entfernt werden. Es wurde nichts gelöscht. Bitte öffne die App neu und versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't find this phone's sign-in, so it couldn't be removed on the server. Nothing was deleted. Please reopen the app and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el inicio de sesión de este teléfono, así que no se pudo quitar en el servidor. No se borró nada. Vuelve a abrir la app e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion de ce téléphone introuvable : impossible de le retirer sur le serveur. Rien n'a été supprimé. Rouvrez l'application et réessayez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Info masuk ponsel ini tidak ditemukan, jadi tidak bisa dikeluarkan di server. Tidak ada yang dihapus. Buka lagi aplikasinya lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso di questo telefono non trovato, quindi non è stato possibile rimuoverlo dal server. Non è stato eliminato nulla. Riapri l'app e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマホのログイン情報が見つからず、サーバーから外せませんでした。何も削除していません。アプリを開き直してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폰의 로그인 정보를 찾지 못해 서버에서 뺄 수 없었어요. 아무것도 지우지 않았어요. 앱을 다시 켠 뒤 다시 해 주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não encontramos o login deste telefone, então não foi possível removê-lo no servidor. Nada foi apagado. Abra o app de novo e tente outra vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не найден вход этого телефона, поэтому удалить его на сервере не удалось. Ничего не удалено. Откройте приложение заново и попробуйте ещё раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบข้อมูลการเข้าสู่ระบบของโทรศัพท์เครื่องนี้ จึงนำออกที่เซิร์ฟเวอร์ไม่ได้ ยังไม่ได้ลบอะไร โปรดเปิดแอปใหม่แล้วลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy thông tin đăng nhập của điện thoại này nên không thể xóa trên máy chủ. Chưa có gì bị xóa. Hãy mở lại ứng dụng rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到此手机的登录信息，无法在服务器上移出。没有删除任何内容。请重新打开应用后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到此手機的登入資訊，無法在伺服器上移出。沒有刪除任何內容。請重新開啟應用程式後再試。"
          }
        }
      }
    },
