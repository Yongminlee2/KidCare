    "control_error_message_notification_off": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachricht konnte nicht angezeigt werden, weil Benachrichtigungen auf dem Handy Ihres Kindes aus sind. Gehen Sie dort zu Einstellungen → Apps → KidCare → Benachrichtigungen und schalten Sie sie ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message could not be shown because notifications are off on your child's phone. Go to Settings → Apps → KidCare → Notifications on that phone and turn them on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo mostrar el mensaje porque las notificaciones están desactivadas en el teléfono de tu hijo. Ve a Ajustes → Aplicaciones → KidCare → Notificaciones en ese teléfono y actívalas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message n'a pas pu s'afficher parce que les notifications sont désactivées sur le téléphone de votre enfant. Allez dans Paramètres → Applications → KidCare → Notifications sur ce téléphone et activez-les."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan tidak bisa ditampilkan karena notifikasi mati di ponsel anak Anda. Buka Setelan → Aplikasi → KidCare → Notifikasi di ponsel itu lalu nyalakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il messaggio non è stato mostrato perché le notifiche sono spente sul telefono di tuo figlio. Vai in Impostazioni → App → KidCare → Notifiche su quel telefono e attivale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さんの端末で通知がオフのためメッセージを表示できませんでした。その端末の設定→アプリ→KidCare→通知でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이 폰에서 알림이 꺼져 있어 메시지를 띄우지 못했어요. 아이 폰 설정 → 앱 → '우리아이 지킴이' → 알림에서 켜주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não deu para mostrar o recado porque as notificações estão desligadas no celular do seu filho. Vá em Configurações → Aplicativos → KidCare → Notificações naquele celular e ative."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение не показалось, потому что на телефоне ребёнка выключены уведомления. Откройте на том телефоне Настройки → Приложения → KidCare → Уведомления и включите их."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงข้อความไม่ได้เพราะการแจ้งเตือนปิดอยู่บนมือถือของลูก ไปที่ตั้งค่า → แอป → KidCare → การแจ้งเตือน บนเครื่องนั้นแล้วเปิด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không hiện được lời nhắn vì thông báo đang tắt trên điện thoại của con. Vào Cài đặt → Ứng dụng → KidCare → Thông báo trên máy đó rồi bật lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "孩子手机上的通知已关闭，无法显示留言。请在那台手机的设置→应用→KidCare→通知里打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "孩子手機上的通知已關閉，無法顯示留言。請在那支手機的設定→應用程式→KidCare→通知裡打開。"
          }
        }
      }
    },
    "control_error_ringer_denied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigung für Toneinstellungen ist auf dem Handy Ihres Kindes aus. Sie muss dort eingeschaltet werden, damit sich das ändern lässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound setting permission is off on your child's phone. It has to be turned on there before this can change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de ajustes de sonido está desactivado en el teléfono de tu hijo. Hay que activarlo allí para poder cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation des réglages de son est désactivée sur le téléphone de votre enfant. Il faut l'activer là-bas pour pouvoir changer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin setelan suara mati di ponsel anak Anda. Harus dinyalakan di sana agar bisa diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il permesso per le impostazioni audio è spento sul telefono di tuo figlio. Va attivato lì per poterlo cambiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さんの端末で音の設定の権限がオフです。その端末でオンにしないと変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이 폰에서 소리 설정 권한이 꺼져 있어요. 아이 폰 설정에서 켜야 바꿀 수 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão de ajustes de som está desligada no celular do seu filho. Precisa ativar lá para poder mudar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На телефоне ребёнка выключено разрешение на настройки звука. Его нужно включить там, иначе изменить нельзя."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์ตั้งค่าเสียงปิดอยู่บนมือถือของลูก ต้องเปิดที่เครื่องนั้นถึงจะเปลี่ยนได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền chỉnh âm thanh đang tắt trên điện thoại của con. Phải bật ở máy đó thì mới đổi được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "孩子手机上的声音设置权限已关闭。要在那台手机上打开才能更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "孩子手機上的聲音設定權限已關閉。要在那支手機上打開才能變更。"
          }
        }
      }
    },
    "control_find_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es klingelt laut, auch im Lautlos-Modus. Nach 5 Minuten hört es von selbst auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It rings loudly even in silent mode. It stops on its own after 5 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena fuerte aunque esté en silencio. Se para sola a los 5 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela sonne fort même en mode silencieux. Cela s'arrête tout seul au bout de 5 minutes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi keras meski mode senyap. Berhenti sendiri setelah 5 menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona forte anche in modalità silenziosa. Dopo 5 minuti si ferma da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マナーモードでも大きな音で鳴ります。5分たつと自動で止まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무음이어도 큰 소리로 울려요. 5분이 지나면 저절로 멈춰요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca alto mesmo no modo silencioso. Para sozinho depois de 5 minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звонит громко даже в беззвучном режиме. Через 5 минут прекращается сам."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดังเสียงดังแม้อยู่ในโหมดเงียบ และหยุดเองเมื่อผ่านไป 5 นาที"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó kêu to ngay cả khi đang im lặng. Sau 5 phút nó tự tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使静音也会大声响起。过5分钟会自动停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使是靜音也會大聲響起。過5分鐘會自動停止。"
          }
        }
      }
    },
