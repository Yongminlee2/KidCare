    "map_battery_info_message": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 잔량은 아이 휴대폰이 보낸 상태로 확인할 수 있어요. 어떤 앱이 배터리를 얼마나 사용했는지는 안드로이드 보안 정책상 원격으로 읽을 수 없으며, 아이 휴대폰의 설정 > 배터리에서 직접 확인해야 해요."
          }
        }
      }
    },
    "map_battery_info_title": {
      "extractionState": "manual",
      "localizations": {
