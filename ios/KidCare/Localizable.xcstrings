    "alert_service_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingeschaltet erreichen Sie Meldungen auch, wenn die App geschlossen ist. Dafür bleibt eine kleine Anzeige in Ihrer Statusleiste und es kostet etwas mehr Akku. Ausgeschaltet sehen Sie Neues nur beim Öffnen der App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this on and updates reach you even when the app is closed. In exchange, a small notification stays in your status bar and it uses a little more battery. Left off, you only see updates when you open the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo activas, los avisos te llegan aunque no tengas la aplicación abierta. A cambio queda un aviso pequeño en tu barra de estado y gasta un poco más de batería. Si lo dejas apagado, solo verás las novedades al abrir la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé, les nouvelles vous parviennent même quand l'application est fermée. En échange, un petit avis reste dans votre barre d'état et cela consomme un peu plus de batterie. Désactivé, vous ne voyez les nouvelles qu'en ouvrant l'application."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau dinyalakan, kabar tetap sampai meski aplikasi tidak dibuka. Sebagai gantinya ada satu pemberitahuan kecil yang tetap di bilah status dan baterai terpakai sedikit lebih banyak. Kalau dimatikan, kabar hanya terlihat saat aplikasi dibuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lo accendi, le novità ti arrivano anche con l'app chiusa. In cambio resta un piccolo avviso nella barra di stato e consuma un po' più di batteria. Se lo lasci spento, vedi le novità solo aprendo l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにするとアプリを開いていなくてもお知らせがすぐ届きます。そのかわりこの端末の通知欄に表示が一つ残り、バッテリーを少し多く使います。オフにするとアプリを開いたときだけ確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 앱을 안 보고 있어도 아이 소식이 바로 와요. 대신 이 폰 알림줄에 '알림 받는 중' 표시가 하나 계속 떠 있고 배터리를 조금 더 씁니다. 꺼두면 앱을 열었을 때만 확인할 수 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com isso ligado, os avisos chegam mesmo com o aplicativo fechado. Em troca, fica um aviso pequeno na sua barra de status e gasta um pouco mais de bateria. Desligado, você só vê as novidades ao abrir o aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включить, новости придут даже при закрытом приложении. Взамен в строке состояния останется небольшое уведомление и расход батареи чуть вырастет. Если выключено, новости видны только при открытии приложения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าเปิด ข่าวจะมาถึงแม้ไม่ได้เปิดแอป แลกกับการที่มีแจ้งเตือนเล็ก ๆ ค้างอยู่ในแถบสถานะและกินแบตเพิ่มขึ้นเล็กน้อย ถ้าปิดไว้จะเห็นข่าวเฉพาะตอนเปิดแอป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật lên thì tin vẫn đến dù không mở ứng dụng. Đổi lại, trên thanh trạng thái luôn còn một thông báo nhỏ và tốn pin thêm một chút. Để tắt thì chỉ thấy tin khi mở ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开后即使没在看应用也能立刻收到消息。代价是这台手机的通知栏会一直留一条提示，并且多耗一点电。关闭时只能在打开应用时查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後即使沒在看應用程式也能立刻收到通知。代價是這支手機的通知列會一直留一則提示，並且多耗一點電。關閉時只能在開啟應用程式時查看。"
          }
        }
      }
    },
    "alert_service_notification_text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingeschaltet, damit Meldungen sofort ankommen. Sie können es im Tab „Meldungen“ ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On, so updates reach you right away. You can turn it off on the Updates tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado, para que los avisos te lleguen enseguida. Puedes apagarlo en la pestaña Novedades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé, pour que les nouvelles vous parviennent tout de suite. Vous pouvez le désactiver dans l'onglet Nouvelles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyala, supaya kabar langsung sampai. Bisa dimatikan di tab Kabar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso, così le novità ti arrivano subito. Puoi spegnerlo nella scheda Novità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お知らせをすぐお届けできるようオンになっています。お知らせタブでオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이 소식을 바로 알려드릴 수 있게 켜져 있어요. 알림 탭에서 끌 수 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligado, para que os avisos cheguem na hora. Você pode desligar na aba Novidades."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено, чтобы новости приходили сразу. Выключить можно на вкладке «Новости»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดอยู่ เพื่อให้ข่าวมาถึงทันที ปิดได้ที่แท็บข่าว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang bật để tin đến ngay. Có thể tắt ở thẻ Tin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已打开，可以立刻把消息送到您这里。可在消息标签里关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開啟，可以立刻把動態送到您這裡。可在通知分頁關閉。"
          }
        }
      }
    },
