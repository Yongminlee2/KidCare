    "leave_family_done_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Elternverbindung auf dem Server und das anonyme Konto wurden gelöscht, und die Familienverbindung auf diesem Handy wurde entfernt. Aufzeichnungen, Zeitpläne und Orte deines Kindes bleiben in der Familie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone's parent link on the server and its anonymous account were deleted, and the family link on this phone was removed. Your child's records, schedules and places stay with the family."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borraron el vínculo de padre en el servidor y la cuenta anónima, y se quitó el vínculo familiar de este teléfono. Los registros, horarios y lugares de tu hijo siguen en la familia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien parent sur le serveur et le compte anonyme ont été supprimés, et le lien familial de ce téléphone a été retiré. Les historiques, horaires et lieux de votre enfant restent dans la famille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan orang tua di server dan akun anonim sudah dihapus, dan tautan keluarga di ponsel ini sudah dihapus. Catatan, jadwal, dan tempat anak tetap ada di keluarga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il collegamento da genitore sul server e l'account anonimo sono stati eliminati, e il collegamento familiare su questo telefono è stato rimosso. I registri, le programmazioni e i luoghi di tuo figlio restano nella famiglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー上の保護者連携と匿名アカウントを削除し、このスマホから家族との連携を削除しました。お子さんの記録や予約・場所は家族にそのまま残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버의 보호자 연결과 익명 계정을 지우고, 이 폰에서 가족 연결을 지웠어요. 아이 폰의 기록과 예약·장소는 가족에 그대로 남아 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O vínculo de responsável no servidor e a conta anônima foram apagados, e o vínculo familiar deste telefone foi removido. Os registros, horários e lugares da criança continuam na família."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связь родителя на сервере и анонимный аккаунт удалены, связь с семьёй на этом телефоне стёрта. Записи, расписания и места ребёнка остаются в семье."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบการเชื่อมต่อผู้ปกครองบนเซิร์ฟเวอร์และบัญชีไม่ระบุตัวตนแล้ว และลบการเชื่อมต่อครอบครัวในโทรศัพท์เครื่องนี้แล้ว บันทึก ตารางเวลา และสถานที่ของลูกยังอยู่ในครอบครัว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xóa liên kết phụ huynh trên máy chủ và tài khoản ẩn danh, đồng thời xóa liên kết gia đình trên điện thoại này. Lịch sử, lịch hẹn và địa điểm của con vẫn ở lại trong gia đình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除服务器上的家长连接和匿名账号，并清除了此手机上的家庭连接。孩子的记录、预约和地点仍保留在家庭中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已刪除伺服器上的家長連結和匿名帳號，並清除了此手機上的家庭連結。孩子的紀錄、預約和地點仍保留在家庭中。"
          }
        }
      }
    },
    "leave_family_done_signed_out_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Elternverbindung auf dem Server wurde gelöscht und die Familienverbindung auf diesem Handy entfernt. Das Löschen des anonymen Kontos ließ sich nicht bestätigen, daher wurde das Handy nur abgemeldet. Falls das Konto noch existiert, enthält es nur seine ID und das Erstellungsdatum, keine Familiendaten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone's parent link on the server was deleted, and the family link on this phone was removed. Deleting the anonymous account couldn't be confirmed, so this phone was only signed out. If that account remains, it keeps only its ID and creation time, with no family info."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borró el vínculo de padre en el servidor y se quitó el vínculo familiar de este teléfono. No se pudo confirmar el borrado de la cuenta anónima, así que solo se cerró la sesión. Si la cuenta sigue existiendo, solo guarda su ID y su fecha de creación, sin datos de la familia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien parent sur le serveur a été supprimé et le lien familial de ce téléphone retiré. La suppression du compte anonyme n'a pas pu être confirmée, ce téléphone a donc seulement été déconnecté. Si ce compte existe encore, il ne contient que son identifiant et sa date de création, sans aucune info sur la famille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan orang tua di server sudah dihapus, dan tautan keluarga di ponsel ini sudah dihapus. Penghapusan akun anonim tidak bisa dipastikan, jadi ponsel ini hanya dikeluarkan dari akun. Jika akun itu masih ada, isinya hanya ID dan waktu pembuatan, tanpa info keluarga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il collegamento da genitore sul server è stato eliminato e il collegamento familiare su questo telefono è stato rimosso. Non è stato possibile confermare l'eliminazione dell'account anonimo, quindi è stata eseguita solo la disconnessione. Se l'account esiste ancora, contiene solo il suo ID e la data di creazione, senza dati sulla famiglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー上の保護者連携を削除し、このスマホから家族との連携を削除しました。匿名アカウントは削除を確認できなかったため、ログアウトだけしました。アカウントが残っていても、家族の情報はなくアカウント番号と作成日時だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버의 보호자 연결을 지우고, 이 폰에서 가족 연결을 지웠어요. 익명 계정은 삭제를 확인하지 못해 로그아웃만 했어요. 계정이 남아 있더라도 가족 정보 없이 계정 번호와 만든 시각만 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O vínculo de responsável no servidor foi apagado e o vínculo familiar deste telefone foi removido. Não foi possível confirmar a exclusão da conta anônima, então só foi feito o logout. Se a conta ainda existir, ela guarda apenas o ID e a data de criação, sem dados da família."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связь родителя на сервере удалена, связь с семьёй на этом телефоне стёрта. Удаление анонимного аккаунта подтвердить не удалось, поэтому выполнен только выход. Если аккаунт остался, в нём есть только номер и время создания, без данных о семье."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบการเชื่อมต่อผู้ปกครองบนเซิร์ฟเวอร์และลบการเชื่อมต่อครอบครัวในโทรศัพท์เครื่องนี้แล้ว ยืนยันการลบบัญชีไม่ระบุตัวตนไม่ได้ จึงออกจากระบบอย่างเดียว หากบัญชียังอยู่ ก็มีเพียงหมายเลขบัญชีและเวลาที่สร้าง ไม่มีข้อมูลครอบครัว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xóa liên kết phụ huynh trên máy chủ và xóa liên kết gia đình trên điện thoại này. Không xác nhận được việc xóa tài khoản ẩn danh nên chỉ đăng xuất. Nếu tài khoản vẫn còn, nó chỉ có mã tài khoản và thời gian tạo, không có thông tin gia đình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除服务器上的家长连接，并清除了此手机上的家庭连接。未能确认匿名账号已删除，因此只做了退出登录。即使账号仍在，也只有账号编号和创建时间，没有家庭信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已刪除伺服器上的家長連結，並清除了此手機上的家庭連結。無法確認匿名帳號已刪除，因此只做了登出。即使帳號仍在，也只有帳號編號和建立時間，沒有家庭資訊。"
          }
        }
      }
    },
