    "perm_location_reason": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird gebraucht, damit deine Eltern wissen, wo du gerade bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed so your parents know where you are right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace falta para que tus padres sepan dónde estás ahora mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour que tes parents sachent où tu es en ce moment."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperlukan supaya orang tuamu tahu kamu sedang di mana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve perché i tuoi genitori sappiano dove sei adesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまどこにいるかを保護者に伝えるために必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 어디 있는지 부모님께 알려주기 위해 필요해요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso para os seus pais saberem onde você está agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно, чтобы родители знали, где ты сейчас."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำเป็นเพื่อให้พ่อแม่รู้ว่าตอนนี้หนูอยู่ที่ไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần có để bố mẹ biết con đang ở đâu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了让爸爸妈妈知道我现在在哪里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了讓爸爸媽媽知道我現在在哪裡。"
          }
        }
      }
    },
