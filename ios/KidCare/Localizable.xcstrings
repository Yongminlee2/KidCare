    "role_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Verbinden können Sie neu wählen.\nNach dem Verbinden lässt es sich nicht mehr ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can choose again before connecting.\nOnce connected, it cannot be changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes elegir otra vez antes de conectar.\nUna vez conectado, ya no se puede cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez choisir à nouveau avant de connecter.\nUne fois connecté, cela ne peut plus changer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebelum tersambung masih bisa dipilih ulang.\nSetelah tersambung tidak bisa diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi scegliere di nuovo prima di collegarti.\nDopo il collegamento non si può più cambiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つなぐ前なら選び直せます。\nつながったあとは変えられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 전에는 다시 고를 수 있어요.\n연결이 끝나면 바꿀 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode escolher de novo antes de conectar.\nDepois de conectar, não dá para mudar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До подключения можно выбрать заново.\nПосле подключения изменить нельзя."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนเชื่อมต่อยังเลือกใหม่ได้\nเชื่อมต่อแล้วเปลี่ยนไม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi kết nối vẫn chọn lại được.\nKết nối xong thì không đổi được nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接前还可以重新选。\n连接完成后就不能更改了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線前還可以重新選。\n連線完成後就不能變更了。"
          }
        }
      }
    },
