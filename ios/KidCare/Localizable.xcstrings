        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa điểm mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新地点"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新地點"
          }
        }
      }
    },
    "place_empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Orte.\nTippen Sie unten auf „Ort hinzufügen“\nund legen Sie etwa „Schule“ oder „Kurs“ fest.\nWir sagen Bescheid, wenn Ihr Kind ankommt oder weggeht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No places yet.\nTap 'Add a place' below\nand pick somewhere like 'School' or 'Academy'.\nWe will tell you when your child arrives or leaves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay lugares.\nToca «Añadir un lugar» abajo\ny elige sitios como «Colegio» o «Academia».\nTe avisaremos cuando tu hijo llegue o salga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de lieux.\nAppuyez sur « Ajouter un lieu » ci-dessous\net enregistrez des endroits comme « École » ou « Cours ».\nNous vous préviendrons quand votre enfant arrive ou part."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada tempat.\nKetuk «Tambah tempat» di bawah\nlalu simpan tempat seperti «Sekolah» atau «Les».\nKami beri tahu saat anak Anda sampai atau keluar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun luogo.\nTocca «Aggiungi un luogo» qui sotto\ne salva posti come «Scuola» o «Corso».\nTi avviseremo quando tuo figlio arriva o esce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ登録した場所がありません。\n下の「場所を追加」を押して\n「学校」「塾」などを登録してみてください。\nお子さんが到着したり出発したらお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 정해둔 장소가 없어요.\n아래 '장소 추가'를 눌러\n'학교', '학원' 같은 곳을 정해 보세요.\n아이가 도착하거나 나서면 알려드릴게요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há lugares.\nToque em «Adicionar um lugar» abaixo\ne escolha lugares como «Escola» ou «Curso».\nAvisamos quando o seu filho chegar ou sair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мест пока нет.\nНажмите «Добавить место» внизу\nи укажите, например, «Школа» или «Кружок».\nМы сообщим, когда ребёнок придёт или уйдёт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีสถานที่\nกด «เพิ่มสถานที่» ข้างล่าง\nแล้วตั้งที่อย่าง «โรงเรียน» หรือ «ที่เรียนพิเศษ»\nเราจะแจ้งตอนลูกมาถึงหรือออกไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có địa điểm nào.\nHãy bấm «Thêm địa điểm» bên dưới\nrồi lưu những chỗ như «Trường» hay «Lớp học thêm».\nChúng tôi sẽ báo khi con đến hoặc rời đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有设置地点。\n按下面的“添加地点”，\n设置“学校”“补习班”这样的地方吧。\n孩子到达或离开时会通知您。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有設定地點。\n按下面的「新增地點」，\n設定「學校」「補習班」這樣的地方吧。\n孩子抵達或離開時會通知您。"
          }
        }
      }
    },
