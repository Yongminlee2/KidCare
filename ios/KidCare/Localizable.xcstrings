    "alert_permission_off": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Handy Ihres Kindes wurde eine Berechtigung ausgeschaltet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A permission was turned off on your child's phone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desactivó un permiso en el teléfono de tu hijo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autorisation a été désactivée sur le téléphone de votre enfant"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah izin dimatikan di ponsel anak Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul telefono di tuo figlio è stato spento un permesso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さんの端末で権限がオフになりました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애기폰에서 권한이 꺼졌어요"
          }
        },
        "pt": {
