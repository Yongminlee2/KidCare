    "ios_leave_family_done_not_signed_out_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This iPhone's guardian link on the server was deleted, and the family link on this phone was removed. Deleting the anonymous account couldn't be confirmed, and signing out didn't work either. That account keeps only its ID and creation time, with no family info."
          }
