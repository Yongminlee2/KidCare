    "child_permission_missing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist ausgeschaltet.\nSchalte es ein, damit dein Standort übertragen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is turned off.\nTurn it on so your location can be shared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está desactivado.\nActívalo para que se pueda enviar tu ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est désactivé.\nActive-le pour que ta position puisse être envoyée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sedang mati.\nNyalakan supaya lokasimu bisa terkirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è spento.\nAttivalo perché la tua posizione possa essere inviata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@がオフになっています。\nオンにすると位置が届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 이(가) 꺼져 있어요.\n켜야 위치가 전달됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está desligado.\nAtive para a sua localização poder ser enviada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ выключено.\nВключи, чтобы геопозиция передавалась."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ปิดอยู่\nเปิดแล้วตำแหน่งถึงจะส่งได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đang tắt.\nHãy bật lên để vị trí được gửi đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@已关闭。\n打开后位置才能传送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@已關閉。\n打開後位置才會傳出去。"
          }
        }
      }
    },
    "child_play_services_fix": {
      "extractionState": "manual",
      "localizations": {
