    "pairing_guardian_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die App auf dem Handy Ihres Kindes,\nwählen Sie „Kind“ und geben Sie diesen Code ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your child's phone, open the app,\nchoose 'Child' and enter this code to connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el teléfono de tu hijo, abre la aplicación,\nelige «Hijo» y escribe este código para conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le téléphone de votre enfant, ouvrez l'application,\nchoisissez « Enfant » et saisissez ce code pour connecter."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di ponsel anak Anda, buka aplikasinya,\npilih «Anak» lalu masukkan kode ini untuk menyambung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul telefono di tuo figlio apri l'app,\nscegli «Bambino» e scrivi questo codice per collegarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さんの端末でアプリを開き\n「お子さん」を選んでこの番号を入れるとつながります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이 폰에서 앱을 켜고\n'아이'를 고른 뒤 이 번호를 넣으면 연결됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No celular do seu filho, abra o aplicativo,\nescolha «Criança» e digite este código para conectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На телефоне ребёнка откройте приложение,\nвыберите «Ребёнок» и введите этот номер."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนมือถือของลูก ให้เปิดแอป\nเลือก «ลูก» แล้วใส่รหัสนี้ก็จะเชื่อมต่อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên điện thoại của con, hãy mở ứng dụng,\nchọn «Con» rồi nhập mã này để kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在孩子手机上打开应用，\n选“孩子”后输入这个号码就能连上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在孩子手機上開啟應用程式，\n選「孩子」後輸入這個號碼就能連上。"
          }
        }
      }
    },
    "pairing_guardian_invite_guardian_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die App auf dem Handy des anderen Elternteils,\nwählen Sie „Elternteil“ → „Mit Code beitreten“ und geben Sie diesen Code ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the other parent's phone, open the app,\nchoose 'Parent' → 'Join with a code' and enter this code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el teléfono del otro padre, abre la aplicación,\nelige «Padre» → «Unirse con un código» y escribe este código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le téléphone de l'autre parent, ouvrez l'application,\nchoisissez « Parent » → « Rejoindre avec un code » et saisissez ce code."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di ponsel orang tua yang satu lagi, buka aplikasinya,\npilih «Orang tua» → «Gabung dengan kode» lalu masukkan kode ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul telefono dell'altro genitore apri l'app,\nscegli «Genitore» → «Entra con un codice» e scrivi questo codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一人の保護者の端末でアプリを開き\n「保護者」→「招待番号で参加」を選んでこの番号を入れてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 보호자 폰에서 앱을 켜고\n'보호자' → '초대 번호로 참여'를 고른 뒤 이 번호를 넣으세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No celular do outro responsável, abra o aplicativo,\nescolha «Responsável» → «Entrar com um código» e digite este código."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На телефоне другого родителя откройте приложение,\nвыберите «Родитель» → «Войти по коду» и введите этот номер."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนมือถือของผู้ปกครองอีกคน ให้เปิดแอป\nเลือก «ผู้ปกครอง» → «เข้าร่วมด้วยรหัส» แล้วใส่รหัสนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên điện thoại của phụ huynh còn lại, hãy mở ứng dụng,\nchọn «Phụ huynh» → «Vào bằng mã» rồi nhập mã này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一位家长的手机上打开应用，\n选“家长”→“用邀请号码加入”后输入这个号码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一位家長的手機上開啟應用程式，\n選「家長」→「用邀請號碼加入」後輸入這個號碼。"
          }
        }
      }
    },
