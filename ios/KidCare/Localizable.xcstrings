    "control_network_readonly": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android lässt eine andere App das nicht ein- oder ausschalten. Wir können nur den Zustand zeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android does not let another app switch these on or off. We can only show you the state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android no deja que otra aplicación encienda o apague esto. Solo podemos mostrarte el estado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ne laisse pas une autre application activer ou désactiver cela. Nous pouvons seulement montrer l'état."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android tidak mengizinkan aplikasi lain menyalakan atau mematikan ini. Kami hanya bisa menunjukkan keadaannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android non lascia che un'altra app accenda o spenga questo. Possiamo solo mostrare lo stato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン・オフの切り替えはAndroidがほかのアプリに許していません。状態だけをお見せします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄고 켜는 것은 안드로이드가 다른 앱에 허용하지 않아요. 상태만 보여드려요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android não deixa outro aplicativo ligar ou desligar isso. Só dá para mostrar o estado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android не даёт другому приложению включать и выключать это. Мы можем только показать состояние."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปิดปิดสิ่งเหล่านี้ แอนดรอยด์ไม่อนุญาตให้แอปอื่นทำ เราแสดงได้แค่สถานะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android không cho ứng dụng khác bật tắt những thứ này. Chúng tôi chỉ hiện được trạng thái."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开关这些，安卓不允许别的应用来做。这里只显示状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開關這些，Android不允許別的應用程式來做。這裡只顯示狀態。"
          }
        }
      }
    },
