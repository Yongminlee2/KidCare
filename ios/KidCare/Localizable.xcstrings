    "leave_family_unconfirmed_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat nichts bestätigt, daher wurde noch nichts gelöscht. Auf dem Server ist es vielleicht schon entfernt – tippe bitte erneut, sobald du online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No confirmation came from the server, so nothing has been deleted yet. It may already be removed on the server, so please tap again once you're connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no lo confirmó, así que aún no se ha borrado nada. Puede que ya se haya quitado en el servidor; vuelve a tocar cuando tengas conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n'a pas confirmé, donc rien n'a encore été supprimé. Le retrait a peut-être déjà eu lieu sur le serveur : touchez à nouveau une fois connecté."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server tidak memberi konfirmasi, jadi belum ada yang dihapus. Mungkin sudah dikeluarkan di server, jadi ketuk lagi setelah tersambung ke internet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non ha confermato, quindi non è stato ancora eliminato nulla. Sul server potrebbe essere già rimosso: tocca di nuovo quando sei connesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの確認が取れなかったため、まだ何も削除していません。サーバーではすでに外れている可能性があるので、インターネットにつながってからもう一度押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버의 확인을 받지 못해 아직 아무것도 지우지 않았어요. 서버에서는 이미 빠졌을 수도 있으니 인터넷에 연결된 뒤 다시 눌러 주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não confirmou, então nada foi apagado ainda. Talvez já tenha sido removido no servidor; toque de novo quando estiver conectado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не подтвердил, поэтому пока ничего не удалено. На сервере телефон мог уже быть удалён — нажмите ещё раз, когда появится интернет."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้รับการยืนยันจากเซิร์ฟเวอร์ จึงยังไม่ได้ลบอะไรเลย เซิร์ฟเวอร์อาจนำออกไปแล้ว โปรดแตะอีกครั้งเมื่อเชื่อมต่ออินเทอร์เน็ตแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ chưa xác nhận nên chưa có gì bị xóa. Có thể máy chủ đã xóa rồi, hãy nhấn lại sau khi có kết nối mạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未收到服务器确认，因此尚未删除任何内容。服务器上可能已经移出，请在联网后再点一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未收到伺服器確認，因此尚未刪除任何內容。伺服器上可能已經移出，請在連上網路後再點一次。"
          }
        }
      }
    },
