    "place_editor_map_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschieben Sie die Karte, bis das Kreuz in der Mitte auf diesem Ort liegt. Der blaue Kreis ist der Bereich, in dem die Meldung ausgelöst wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the map so the cross in the middle sits on this place. The blue circle is where the alert goes off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el mapa hasta que la cruz del centro quede sobre este lugar. El círculo azul es donde salta el aviso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez la carte pour que la croix du milieu tombe sur ce lieu. Le cercle bleu est la zone où l'avis se déclenche."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser petanya sampai tanda silang di tengah pas di tempat ini. Lingkaran biru adalah daerah tempat pemberitahuan muncul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta la mappa finché la croce al centro non è su questo luogo. Il cerchio azzurro è la zona in cui scatta l'avviso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図を動かして真ん中の十字をこの場所に合わせてください。青い円がお知らせの届く範囲です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도를 움직여 가운데 십자를 이 장소에 맞춰주세요. 파란 원이 알림이 울리는 범위예요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova o mapa até a cruz do meio ficar sobre este lugar. O círculo azul é onde o aviso dispara."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигайте карту, пока крестик в середине не встанет на это место. Синий круг — зона, в которой срабатывает уведомление."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนแผนที่ให้กากบาทตรงกลางตรงกับที่นี่ วงกลมสีฟ้าคือขอบเขตที่แจ้งเตือนจะทำงาน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy di chuyển bản đồ cho dấu thập ở giữa trùng với chỗ này. Vòng tròn xanh là phạm vi báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动地图，让中间的十字对准这个地点。蓝色圆圈是发出通知的范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移動地圖，讓中間的十字對準這個地點。藍色圓圈是發出通知的範圍。"
          }
        }
      }
    },
