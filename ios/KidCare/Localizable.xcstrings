    "control_lock_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert Ihr Kind den Ton, geht er ein paar Sekunden später auf Ihre Wahl zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your child changes the sound, it goes back to what you chose a few seconds later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu hijo cambia el sonido, vuelve a lo que elegiste unos segundos después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre enfant change le son, il revient à votre choix quelques secondes plus tard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau anak Anda mengubah suaranya, beberapa detik kemudian kembali ke pilihan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se tuo figlio cambia il suono, dopo pochi secondi torna a quello che hai scelto tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さんが音を変えても数秒後に保護者が決めたとおりに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이가 소리를 바꿔도 몇 초 뒤에 부모님이 정한 대로 돌아가요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o seu filho mudar o som, ele volta ao que você escolheu poucos segundos depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если ребёнок поменяет звук, через несколько секунд он вернётся к тому, что выбрали вы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าลูกเปลี่ยนเสียง อีกไม่กี่วินาทีจะกลับมาเป็นแบบที่คุณตั้งไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu con đổi âm thanh thì vài giây sau nó quay lại đúng như bạn đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就算孩子改了声音，几秒后也会变回家长设定的样子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "就算孩子改了聲音，幾秒後也會變回家長設定的樣子。"
          }
        }
      }
    },
