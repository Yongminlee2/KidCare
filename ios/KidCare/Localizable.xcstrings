    "ios_child_force_quit_notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "If you close the app all the way (swipe it away in the app switcher), your location stops. Your parents cannot see you until you open it again."
