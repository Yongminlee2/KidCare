    "schedule_empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Zeiten festgelegt.\nTippen Sie unten auf „Regel hinzufügen“\nund probieren Sie etwas wie „Wochentags nachts lautlos“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No times set yet.\nTap 'Add a rule' below\nand try something like 'Silent on weekday nights'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay franjas definidas.\nToca «Añadir una regla» abajo\ny prueba algo como «En silencio las noches entre semana»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de créneaux définis.\nAppuyez sur « Ajouter une règle » ci-dessous\net essayez quelque chose comme « Silencieux les soirs de semaine »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada jam yang diatur.\nKetuk «Tambah aturan» di bawah\nlalu coba aturan seperti «Senyap tiap malam hari kerja»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna fascia oraria.\nTocca «Aggiungi una regola» qui sotto\ne prova qualcosa come «Silenzioso nelle sere feriali»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ決めた時間帯がありません。\n下の「ルールを追加」を押して\n「平日の夜はマナー」のようなルールを作ってみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 정해둔 시간대가 없어요.\n아래 '규칙 추가'를 눌러\n'평일 밤에는 무음' 같은 규칙을 만들어 보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há horários definidos.\nToque em «Adicionar uma regra» abaixo\ne tente algo como «Silencioso nas noites de semana»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Промежутки ещё не заданы.\nНажмите «Добавить правило» внизу\nи попробуйте, например, «Будни ночью — без звука»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ตั้งช่วงเวลา\nกด «เพิ่มกฎ» ข้างล่าง\nแล้วลองตั้งกฎอย่าง «กลางคืนวันธรรมดาให้เงียบ»"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa đặt khung giờ nào.\nHãy bấm «Thêm quy tắc» bên dưới\nrồi thử một quy tắc kiểu «Đêm ngày thường thì im lặng»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有设置时段。\n按下面的“添加规则”，\n试着做一条“工作日晚上静音”这样的规则吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有設定時段。\n按下面的「新增規則」，\n試著做一條「平日晚上靜音」這樣的規則吧。"
          }
        }
      }
    },
