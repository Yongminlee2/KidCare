    "schedule_save_slow": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Speichern wurde gesendet, aber der Server hat es noch nicht bestätigt. Es speichert von selbst, sobald Internet da ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The save was sent but the server has not confirmed it yet. It saves on its own once the internet connects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envió el guardado, pero el servidor todavía no lo ha confirmado. Se guarda solo en cuanto haya internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement a été envoyé mais le serveur ne l'a pas encore confirmé. Il s'enregistre tout seul dès qu'il y a internet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan simpan sudah dikirim tapi server belum memastikan. Tersimpan sendiri begitu ada internet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il salvataggio è stato inviato ma il server non l'ha ancora confermato. Si salva da solo appena c'è internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存のリクエストは送りましたがサーバーの確認がまだです。インターネットにつながれば自動で保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 요청은 보냈지만 아직 서버 확인이 안 됐어요. 인터넷이 연결되면 저절로 저장돼요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O salvamento foi enviado, mas o servidor ainda não confirmou. Salva sozinho assim que houver internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос на сохранение ушёл, но сервер ещё не подтвердил. Сохранится само, как только появится интернет."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งคำขอบันทึกแล้วแต่เซิร์ฟเวอร์ยังไม่ยืนยัน เมื่อมีอินเทอร์เน็ตจะบันทึกเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gửi yêu cầu lưu nhưng máy chủ chưa xác nhận. Khi có mạng nó sẽ tự lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存请求已发出，但服务器还没确认。联网后会自动保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存要求已送出，但伺服器還沒確認。連上網路後會自動儲存。"
          }
        }
      }
    },
