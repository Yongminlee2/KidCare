        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет доступа в интернет. Проверьте Wi-Fi или мобильные данные."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่ออินเทอร์เน็ตไม่ได้ กรุณาตรวจ Wi-Fi หรือเน็ตมือถือ"
