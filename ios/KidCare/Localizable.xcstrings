    "ios_child_perm_always_reason": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "It is set to 'While Using the App'. Your location stops as soon as you leave the screen. Change it to 'Always' in Settings."
          }
        },
        "en": {
