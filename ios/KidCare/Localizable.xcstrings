    "error_server_setup": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Server-Einrichtung ist noch nicht fertig. Sagen Sie der Person Bescheid, die die App installiert hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server setup is not finished yet. Tell whoever installed the app for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración del servidor todavía no está terminada. Avisa a quien te instaló la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration du serveur n'est pas encore terminée. Prévenez la personne qui a installé l'application."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyiapan server belum selesai. Beri tahu orang yang memasang aplikasi ini untuk Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione del server non è ancora finita. Avvisa chi ti ha installato l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの設定がまだ終わっていません。アプリを入れてくれた人に伝えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 설정이 아직 끝나지 않았어요. 앱을 설치해 준 사람에게 알려주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração do servidor ainda não terminou. Avise quem instalou o aplicativo para você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка сервера ещё не закончена. Скажите тому, кто устанавливал приложение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าเซิร์ฟเวอร์ยังไม่เสร็จ กรุณาบอกคนที่ติดตั้งแอปให้คุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc cài đặt máy chủ chưa xong. Hãy báo cho người đã cài ứng dụng giúp bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器还没设置好。请告诉帮您安装应用的人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器還沒設定好。請告訴幫您安裝應用程式的人。"
          }
        }
      }
    },
    "error_unauthenticated": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wurden abgemeldet. Bitte schließen Sie die App und öffnen Sie sie erneut."
          }
