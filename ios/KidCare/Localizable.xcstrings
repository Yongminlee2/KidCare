    "schedule_overlap_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Zeitraum überschneidet sich mit der Regel „%1$@“.\nWährend der Überschneidung gewinnt die später erstellte Regel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This time overlaps the '%1$@' rule.\nWhile they overlap, the rule made later wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta franja se solapa con la regla «%1$@».\nMientras se solapan, gana la regla hecha después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce créneau chevauche la règle « %1$@ ».\nPendant le chevauchement, c'est la règle créée le plus tard qui gagne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam ini bertabrakan dengan aturan «%1$@».\nSelama bertabrakan, aturan yang dibuat belakangan yang menang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa fascia si sovrappone alla regola «%1$@».\nMentre si sovrappongono vince la regola creata dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時間帯は「%1$@」のルールと重なります。\n重なっているあいだは後から作ったルールが優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시간대는 '%1$@' 규칙과 겹칩니다.\n겹치는 동안에는 나중에 만든 규칙이 이깁니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este horário se sobrepõe à regra «%1$@».\nEnquanto se sobrepõem, vence a regra feita depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот промежуток пересекается с правилом «%1$@».\nПока они пересекаются, побеждает правило, созданное позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงเวลานี้ทับกับกฎ «%1$@»\nระหว่างที่ทับกัน กฎที่สร้างทีหลังจะชนะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khung giờ này trùng với quy tắc «%1$@».\nTrong lúc trùng nhau, quy tắc tạo sau sẽ thắng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个时段和“%1$@”规则重叠。\n重叠期间，后做的规则优先。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個時段和「%1$@」規則重疊。\n重疊期間，後做的規則優先。"
          }
        }
      }
    },
    "schedule_overlap_message_more": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Zeitraum überschneidet sich mit „%1$@“ und %2$d weiteren Regeln.\nWährend der Überschneidung gewinnt die später erstellte Regel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This time overlaps '%1$@' and %2$d more rules.\nWhile they overlap, the rule made later wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta franja se solapa con «%1$@» y %2$d reglas más.\nMientras se solapan, gana la regla hecha después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce créneau chevauche « %1$@ » et %2$d autres règles.\nPendant le chevauchement, c'est la règle créée le plus tard qui gagne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam ini bertabrakan dengan «%1$@» dan %2$d aturan lain.\nSelama bertabrakan, aturan yang dibuat belakangan yang menang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa fascia si sovrappone a «%1$@» e ad altre %2$d regole.\nMentre si sovrappongono vince la regola creata dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時間帯は「%1$@」ほか%2$d件のルールと重なります。\n重なっているあいだは後から作ったルールが優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시간대는 '%1$@' 외 %2$d개 규칙과 겹칩니다.\n겹치는 동안에는 나중에 만든 규칙이 이깁니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este horário se sobrepõe a «%1$@» e mais %2$d regras.\nEnquanto se sobrepõem, vence a regra feita depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот промежуток пересекается с «%1$@» и ещё %2$d правилами.\nПока они пересекаются, побеждает правило, созданное позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงเวลานี้ทับกับ «%1$@» และอีก %2$d กฎ\nระหว่างที่ทับกัน กฎที่สร้างทีหลังจะชนะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khung giờ này trùng với «%1$@» và %2$d quy tắc khác.\nTrong lúc trùng nhau, quy tắc tạo sau sẽ thắng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个时段和“%1$@”等%2$d条规则重叠。\n重叠期间，后做的规则优先。"
          }
        },
        "zh-Hant": {
