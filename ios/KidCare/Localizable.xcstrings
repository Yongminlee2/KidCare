    "schedule_delete_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nNach dem Löschen ändert sich der Ton in diesem Zeitraum nicht mehr von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nOnce deleted, the sound will not change on its own during this time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nUna vez borrada, el sonido ya no cambiará solo durante esta franja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nUne fois supprimée, le son ne changera plus tout seul sur ce créneau."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nSetelah dihapus, suara pada jam segini tidak berubah sendiri lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nUna volta eliminata, in questa fascia il suono non cambierà più da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\n削除するとこの時間帯に音が自動で変わらなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\n지우면 이 시간대에는 소리가 저절로 바뀌지 않아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nDepois de excluir, o som não muda mais sozinho neste horário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nПосле удаления звук в этот промежуток больше не будет меняться сам."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nลบแล้วเสียงในช่วงเวลานี้จะไม่เปลี่ยนเองอีก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nXóa rồi thì trong khung giờ này âm thanh không tự đổi nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\n删除后，这个时段的声音不会再自动改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\n刪除後，這個時段的聲音不會再自動改變。"
          }
        }
      }
    },
