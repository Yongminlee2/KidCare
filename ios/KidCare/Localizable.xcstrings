    "place_limit_notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können bis zu %1$d Orte speichern. Für einen neuen löschen Sie zuerst einen, den Sie nicht mehr brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can save up to %1$d places. To add a new one, delete a place you no longer use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes guardar hasta %1$d lugares. Para añadir uno nuevo, borra alguno que ya no uses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez enregistrer jusqu'à %1$d lieux. Pour en ajouter un, supprimez d'abord un lieu que vous n'utilisez plus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda bisa menyimpan sampai %1$d tempat. Untuk menambah yang baru, hapus dulu tempat yang tidak dipakai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi salvare fino a %1$d luoghi. Per aggiungerne uno nuovo, elimina prima un luogo che non usi più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所は%1$d件まで登録できます。新しく作るには使っていない場所を先に削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소는 %1$d개까지 정할 수 있어요. 새로 만들려면 안 쓰는 장소를 먼저 지워주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode salvar até %1$d lugares. Para adicionar um novo, exclua algum que já não usa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно сохранить до %1$d мест. Чтобы добавить новое, удалите место, которым больше не пользуетесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งสถานที่ได้ถึง %1$d แห่ง ถ้าจะเพิ่มใหม่ให้ลบที่ที่ไม่ใช้แล้วก่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn lưu được tối đa %1$d địa điểm. Muốn thêm chỗ mới, hãy xóa bớt chỗ không dùng nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可以设置%1$d个地点。要新建，请先删除不用的地点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可以設定%1$d個地點。要新增，請先刪除不用的地點。"
          }
        }
      }
    },
    "place_no_family": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Familie wurde nicht gefunden. Bitte schließen Sie die App und öffnen Sie sie erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not find your family. Please close the app and open it again."
