    "control_message_hint_detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es erscheint groß auf dem Bildschirm Ihres Kindes. Ohne Ton, nur eine Vibration. Tippt Ihr Kind auf „Verstanden“, wird daraus hier „Gelesen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It shows up large on your child's screen. It makes no sound, just one vibration. When your child taps 'Got it', this changes to 'Read'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece en grande en la pantalla de tu hijo. No hace ruido, solo una vibración. Cuando tu hijo toca «Entendido», esto cambia a «Leído»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela s'affiche en grand sur l'écran de votre enfant. Sans son, juste une vibration. Quand votre enfant appuie sur « Compris », cela devient « Lu » ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muncul besar di layar anak Anda. Tanpa suara, hanya sekali getar. Begitu anak Anda menekan «Sudah lihat», ini berubah jadi «Dibaca»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare in grande sullo schermo di tuo figlio. Non fa rumore, solo una vibrazione. Quando tuo figlio tocca «Ho capito», qui diventa «Letto»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さんの画面に大きく表示されます。音は鳴らず、振動が一度だけです。お子さんが「確認したよ」を押すとここが「既読」に変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이 폰 화면에 크게 떠요. 소리는 나지 않고 진동만 한 번 울려요. 아이가 '확인했어요'를 누르면 여기에 '읽음'으로 바뀝니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece grande na tela do seu filho. Não faz barulho, só uma vibração. Quando o seu filho tocar em «Entendi», isto muda para «Lido»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Появится крупно на экране ребёнка. Без звука, только одна вибрация. Когда ребёнок нажмёт «Понял», здесь появится «Прочитано»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะขึ้นตัวใหญ่บนหน้าจอของลูก ไม่มีเสียง มีแค่สั่นครั้งเดียว เมื่อลูกกด «รับทราบแล้ว» ตรงนี้จะเปลี่ยนเป็น «อ่านแล้ว»"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó hiện thật to trên màn hình của con. Không kêu tiếng nào, chỉ rung một lần. Khi con bấm «Con thấy rồi», chỗ này đổi thành «Đã đọc»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会在孩子手机屏幕上大大地显示。不发出声音，只震动一次。孩子按下“我看到了”后，这里会变成“已读”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會在孩子手機螢幕上大大地顯示。不會發出聲音，只震動一次。孩子按下「我看到了」後，這裡會變成「已讀」。"
          }
        }
      }
    },
