    "perm_battery_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Einstellungsbildschirm aufgeht, suchen Sie KidCare in der Liste und stellen Sie es auf „Nicht eingeschränkt“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the settings screen opens, find KidCare in the list and change it to 'Unrestricted'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se abra la pantalla de ajustes, busca KidCare en la lista y cámbialo a «Sin restricciones»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand l'écran des paramètres s'ouvre, trouvez KidCare dans la liste et passez-le sur « Sans restriction »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah layar setelan terbuka, cari KidCare di daftarnya lalu ubah jadi «Tanpa batasan»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando si apre la schermata delle impostazioni, trova KidCare nell'elenco e mettilo su «Senza restrizioni»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定画面が開いたら一覧からKidCareを探して「制限なし」に変えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 화면이 열리면 목록에서 '우리아이 지킴이'를 찾아 '제한 없음'으로 바꿔주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a tela de configurações abrir, procure KidCare na lista e mude para «Sem restrição»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда откроется экран настроек, найдите в списке KidCare и поставьте «Без ограничений»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อหน้าตั้งค่าเปิดขึ้น ให้หา KidCare ในรายการแล้วเปลี่ยนเป็น «ไม่จำกัด»"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi màn hình cài đặt mở ra, hãy tìm KidCare trong danh sách rồi đổi thành «Không giới hạn»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置画面打开后，在列表里找到KidCare，改成“无限制”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定畫面開啟後，在清單裡找到KidCare，改成「不受限制」。"
          }
        }
      }
    },
    "perm_battery_reason": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne das legt das Handy die App schlafen und der Standort bricht ab. Wählen Sie im Einstellungsbildschirm „Zulassen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without this, the phone puts the app to sleep and the location stops. Choose 'Allow' on the settings screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin esto, el teléfono duerme la aplicación y la ubicación se corta. Elige «Permitir» en la pantalla de ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans cela, le téléphone met l'application en veille et la position s'interrompt. Choisissez « Autoriser » dans l'écran des paramètres."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa ini ponsel menidurkan aplikasinya dan lokasinya terputus. Pilih «Izinkan» di layar setelan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza questo il telefono mette l'app in pausa e la posizione si interrompe. Scegli «Consenti» nella schermata delle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これをオンにしないと端末がアプリを眠らせて位置が途切れます。設定画面で「許可」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이걸 안 켜면 폰이 앱을 잠재워서 위치가 끊겨요. 설정 화면에서 '허용'을 골라주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem isso, o celular coloca o aplicativo para dormir e a localização é cortada. Escolha «Permitir» na tela de configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без этого телефон усыпляет приложение и геопозиция обрывается. Выберите «Разрешить» на экране настроек."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าไม่เปิด เครื่องจะพักแอปแล้วตำแหน่งจะขาดหาย กรุณาเลือก «อนุญาต» ในหน้าตั้งค่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bật cái này thì điện thoại ru ngủ ứng dụng và vị trí bị đứt. Hãy chọn «Cho phép» ở màn hình cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不打开这个，手机会让应用休眠，位置就会中断。请在设置画面里选“允许”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不開這個，手機會讓應用程式休眠，位置就會中斷。請在設定畫面選「允許」。"
          }
        }
      }
    },
