          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo No molestar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode Ne pas déranger"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode Jangan ganggu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità Non disturbare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイレントモード"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방해금지 모드"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Não perturbe"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим «Не беспокоить»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมดห้ามรบกวน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ Không làm phiền"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勿扰模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "勿擾模式"
          }
        }
      }
    },
    "control_ringer_dnd_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange Bitte nicht stören an ist, meldet Android lautlos, auch wenn das Klingeln eingestellt ist. Deshalb kann der Tonzustand oben ungenau sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Do Not Disturb is on, Android reports silent even if the ringer is set to ring. That is why the sound state above may not be exact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con No molestar activado, Android informa silencio aunque el tono esté puesto. Por eso el estado de sonido de arriba puede no ser exacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand Ne pas déranger est activé, Android indique silencieux même si la sonnerie est réglée. C'est pourquoi l'état du son ci-dessus peut être inexact."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama mode Jangan ganggu menyala, Android melaporkan senyap meski deringnya dipasang. Karena itu keadaan suara di atas bisa tidak persis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Non disturbare attivo, Android segnala silenzioso anche se è impostata la suoneria. Per questo lo stato del suono sopra può non essere esatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイレントモードが入っていると、着信音に設定していてもAndroidはマナーだと伝えてきます。上の音の状態はそのため正確でないことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방해금지가 켜져 있으면 벨소리로 맞춰 둬도 안드로이드가 무음이라고 알려줘요. 위의 소리 상태는 그래서 정확하지 않을 수 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com Não perturbe ligado, o Android informa silencioso mesmo com o toque ativado. Por isso o estado do som acima pode não ser exato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока включён режим «Не беспокоить», Android сообщает беззвучный режим, даже если стоит звонок. Поэтому состояние звука выше может быть неточным."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะเปิดโหมดห้ามรบกวน แอนดรอยด์จะรายงานว่าเงียบแม้ตั้งเสียงเรียกเข้าไว้ สถานะเสียงด้านบนจึงอาจไม่ตรง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi chế độ Không làm phiền đang bật, Android báo là im lặng dù máy đang để chuông. Vì vậy trạng thái âm thanh ở trên có thể không chính xác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开着勿扰模式时，即使设成响铃，安卓也会报成静音。所以上面的声音状态可能不准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開著勿擾模式時，即使設成響鈴，Android也會回報成靜音。所以上面的聲音狀態可能不準。"
          }
        }
      }
    },
