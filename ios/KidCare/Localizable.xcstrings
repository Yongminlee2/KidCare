            "state": "translated",
            "value": "하루 종일로 저장"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar como dia inteiro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить на весь день"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกเป็นทั้งวัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu là cả ngày"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按全天保存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以全天儲存"
          }
        }
      }
    },
    "schedule_allday_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfang und Ende sind beide %1$@.\nSo gespeichert stehen die gewählten Tage 24 Stunden lang auf %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The start and the end are both %1$@.\nSaved like this, the chosen days switch to %2$@ for the whole 24 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El principio y el final son los dos %1$@.\nGuardado así, los días elegidos pasan a %2$@ durante las 24 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le début et la fin sont tous les deux %1$@.\nEnregistré ainsi, les jours choisis passent en %2$@ pendant 24 heures."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Awal dan akhirnya sama-sama %1$@.\nKalau disimpan begini, pada hari yang dipilih jadi %2$@ selama 24 jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inizio e la fine sono tutti e due %1$@.\nSalvata così, nei giorni scelti resta su %2$@ per tutte le 24 ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始と終了がどちらも%1$@です。\nこのまま保存すると選んだ曜日は24時間ずっと%2$@になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작과 끝이 %1$@(으)로 같아요.\n이대로 저장하면 고른 요일에는 24시간 내내 %2$@(으)로 바뀝니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O começo e o fim são os dois %1$@.\nSalvo assim, os dias escolhidos ficam em %2$@ durante as 24 horas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начало и конец одинаковые — %1$@.\nЕсли сохранить так, в выбранные дни все 24 часа будет %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาเริ่มกับเวลาจบเป็น %1$@ เหมือนกัน\nถ้าบันทึกแบบนี้ วันที่เลือกไว้จะเป็น %2$@ ตลอด 24 ชั่วโมง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ bắt đầu và giờ kết thúc đều là %1$@.\nLưu như vậy thì vào những ngày đã chọn máy sẽ ở %2$@ suốt 24 giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始和结束都是%1$@。\n就这样保存的话，所选的日子会24小时一直是%2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始和結束都是%1$@。\n就這樣儲存的話，所選的日子會24小時一直是%2$@。"
          }
        }
      }
    },
