    "perm_background_reason": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit der Standort auch bei geschlossener App gesendet wird, muss „Immer zulassen“ gewählt sein. Wählen Sie im Einstellungsbildschirm „Immer zulassen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To send the location while the app is closed, this has to be 'Allow all the time'. Choose 'Allow all the time' on the settings screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para enviar la ubicación con la aplicación cerrada hace falta «Permitir siempre». Elige «Permitir siempre» en la pantalla de ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour envoyer la position quand l'application est fermée, il faut « Toujours autoriser ». Choisissez « Toujours autoriser » dans l'écran des paramètres."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengirim lokasi saat aplikasi tidak dibuka, harus «Izinkan sepanjang waktu». Pilih «Izinkan sepanjang waktu» di layar setelan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per inviare la posizione con l'app chiusa serve «Consenti sempre». Scegli «Consenti sempre» nella schermata delle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開いていないときも位置を送るには「常に許可」が必要です。設定画面で「常に許可」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 안 보고 있을 때도 위치를 보내려면 '항상 허용'이어야 해요. 설정 화면에서 '항상 허용'을 골라주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para enviar a localização com o aplicativo fechado é preciso «Permitir o tempo todo». Escolha «Permitir o tempo todo» na tela de configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы отправлять геопозицию при закрытом приложении, нужно «Разрешать всегда». Выберите «Разрешать всегда» на экране настроек."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะส่งตำแหน่งตอนไม่ได้เปิดแอปต้องเลือก «อนุญาตตลอดเวลา» กรุณาเลือก «อนุญาตตลอดเวลา» ในหน้าตั้งค่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để gửi vị trí khi không mở ứng dụng thì phải chọn «Luôn cho phép». Hãy chọn «Luôn cho phép» ở màn hình cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要在没看应用的时候也发送位置，必须选“始终允许”。请在设置画面里选“始终允许”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要在沒看應用程式的時候也傳送位置，必須選「一律允許」。請在設定畫面選「一律允許」。"
          }
        }
      }
    },
    "perm_background_title": {
