    "pairing_child_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den sechsstelligen Code ein,\nder auf dem Handy deiner Eltern steht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the 6-digit code\nshown on your parent's phone"
          }
        },
        "es": {
