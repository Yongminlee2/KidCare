    "control_command_queued": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht abgeschickt. Sobald Internet da ist, kommt es beim Handy Ihres Kindes an und wird ausgeführt — bis dahin kann sich die Lage geändert haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sent yet. It will reach your child's phone and run once the internet connects — things may have changed by then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no ha salido. Llegará al teléfono de tu hijo y se ejecutará cuando haya internet; para entonces la situación puede haber cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore parti. Cela arrivera sur le téléphone de votre enfant et s'exécutera dès qu'il y aura internet — d'ici là la situation peut avoir changé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum terkirim. Akan sampai ke ponsel anak Anda dan dijalankan begitu ada internet — keadaan bisa berubah sebelum itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora partita. Arriverà al telefono di tuo figlio e verrà eseguita appena c'è internet: nel frattempo la situazione può essere cambiata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ届いていません。インターネットにつながったときにお子さんの端末へ届いて実行されます。そのあいだに状況が変わっているかもしれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 안 갔어요. 인터넷이 연결되면 그때 애기폰으로 가서 실행돼요 — 그 사이 상황이 달라졌을 수 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não saiu. Vai chegar ao celular do seu filho e ser executado quando houver internet — até lá a situação pode ter mudado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё не ушло. Дойдёт до телефона ребёнка и выполнится, когда появится интернет — к тому времени всё может измениться."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ส่งออกไป เมื่อมีอินเทอร์เน็ตจะไปถึงมือถือของลูกและทำงาน ระหว่างนั้นสถานการณ์อาจเปลี่ยนไปแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa gửi đi được. Khi có mạng nó sẽ đến điện thoại của con và chạy — lúc đó tình hình có thể đã khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没送到。等联网后会送到孩子手机上执行——在那之前情况可能已经变了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒送到。等連上網路後會送到孩子手機執行——在那之前情況可能已經變了。"
          }
        }
      }
    },
