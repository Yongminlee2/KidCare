    "control_error_alarm_exact_denied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wecker konnte nicht gestellt werden, weil „Wecker und Erinnerungen“ auf dem Handy Ihres Kindes aus ist. Gehen Sie dort zu Einstellungen → Apps → KidCare → Wecker und Erinnerungen und schalten Sie es ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm could not be set because 'Alarms & reminders' is turned off on your child's phone. Go to Settings → Apps → KidCare → Alarms & reminders on that phone and turn it on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo poner la alarma porque «Alarmas y recordatorios» está desactivado en el teléfono de tu hijo. Ve a Ajustes → Aplicaciones → KidCare → Alarmas y recordatorios en ese teléfono y actívalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'alarme n'a pas pu être posée parce que « Alarmes et rappels » est désactivé sur le téléphone de votre enfant. Allez dans Paramètres → Applications → KidCare → Alarmes et rappels sur ce téléphone et activez-le."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm tidak bisa dipasang karena «Alarm dan pengingat» mati di ponsel anak Anda. Buka Setelan → Aplikasi → KidCare → Alarm dan pengingat di ponsel itu lalu nyalakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sveglia non è stata impostata perché «Sveglie e promemoria» è spento sul telefono di tuo figlio. Vai in Impostazioni → App → KidCare → Sveglie e promemoria su quel telefono e attivalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さんの端末で「アラームとリマインダー」がオフのためアラームを設定できませんでした。その端末の設定→アプリ→KidCare→アラームとリマインダーでオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애기폰에서 '알람 및 리마인더' 권한이 꺼져 있어 알람을 맞추지 못했어요. 아이 폰 설정 → 앱 → '우리아이 지킴이' → 알람 및 리마인더에서 켜주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não deu para pôr o alarme porque «Alarmes e lembretes» está desligado no celular do seu filho. Vá em Configurações → Aplicativos → KidCare → Alarmes e lembretes naquele celular e ative."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будильник не поставился, потому что на телефоне ребёнка выключены «Будильники и напоминания». Откройте на том телефоне Настройки → Приложения → KidCare → Будильники и напоминания и включите."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งปลุกไม่ได้เพราะ «นาฬิกาปลุกและการเตือน» ปิดอยู่บนมือถือของลูก ไปที่ตั้งค่า → แอป → KidCare → นาฬิกาปลุกและการเตือน บนเครื่องนั้นแล้วเปิด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đặt được báo thức vì «Báo thức và lời nhắc» đang tắt trên điện thoại của con. Vào Cài đặt → Ứng dụng → KidCare → Báo thức và lời nhắc trên máy đó rồi bật lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "孩子手机上的“闹钟和提醒”权限已关闭，无法设置闹钟。请在那台手机的设置→应用→KidCare→闹钟和提醒里打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "孩子手機上的「鬧鐘和提醒」權限已關閉，無法設定鬧鐘。請在那支手機的設定→應用程式→KidCare→鬧鐘和提醒裡打開。"
          }
        }
      }
    },
    "control_error_child_failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Handy Ihres Kindes konnte diese Anfrage nicht ausführen."
          }
        },
        "en": {
