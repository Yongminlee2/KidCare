    "control_command_timeout": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Handy Ihres Kindes antwortet nicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your child's phone is not answering"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono de tu hijo no responde"
          }
        },
        "fr": {
