    "place_sync_failed_format": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ort wurde gespeichert, aber das Handy Ihres Kindes konnte nicht benachrichtigt werden. Öffnen Sie diesen Bildschirm erneut, dann versuchen wir es noch einmal.\n%1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The place was saved but your child's phone could not be told. Open this screen again and we will try once more.\n%1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El lugar se guardó, pero no se pudo avisar al teléfono de tu hijo. Vuelve a abrir esta pantalla y lo intentaremos otra vez.\n%1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lieu a été enregistré mais le téléphone de votre enfant n'a pas pu être prévenu. Rouvrez cet écran et nous réessaierons.\n%1$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempatnya tersimpan tapi ponsel anak Anda belum bisa diberi tahu. Buka layar ini lagi dan kami coba sekali lagi.\n%1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il luogo è stato salvato ma non si è riusciti ad avvisare il telefono di tuo figlio. Riapri questa schermata e ci proveremo di nuovo.\n%1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所は保存しましたがお子さんの端末に知らせられませんでした。この画面をもう一度開けばまた知らせます。\n%1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소는 저장했지만 아이 폰에 알리지 못했어요. 이 화면을 다시 열면 한 번 더 알릴게요.\n%1$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O lugar foi salvo, mas não deu para avisar o celular do seu filho. Abra esta tela de novo e tentamos mais uma vez.\n%1$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Место сохранено, но телефон ребёнка не удалось предупредить. Откройте этот экран снова, и мы попробуем ещё раз.\n%1$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกสถานที่แล้วแต่บอกมือถือของลูกไม่สำเร็จ เปิดหน้านี้อีกครั้งแล้วเราจะบอกอีกที\n%1$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu địa điểm nhưng chưa báo được cho điện thoại của con. Mở lại màn hình này thì chúng tôi sẽ báo thêm một lần nữa.\n%1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地点已保存，但没能通知孩子手机。重新打开这个画面会再通知一次。\n%1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地點已儲存，但沒能通知孩子手機。重新開啟這個畫面會再通知一次。\n%1$@"
          }
        }
      }
    },
    "place_sync_no_child": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ort ist gespeichert. Er gilt von selbst, sobald sich das Handy Ihres Kindes verbindet."
          }
        },
        "en": {
