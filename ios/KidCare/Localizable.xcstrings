    "schedule_editor_days_required": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte wählen Sie mindestens einen Tag. Ohne Tag läuft diese Regel nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please pick at least one day. With no day chosen, this rule never runs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige al menos un día. Sin ningún día elegido, esta regla no se activa nunca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez au moins un jour. Sans jour choisi, cette règle ne se déclenche jamais."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih setidaknya satu hari. Kalau tidak ada hari yang dipilih, aturan ini tidak pernah jalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli almeno un giorno. Senza nessun giorno questa regola non si attiva mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曜日を一つ以上選んでください。選ばないとこのルールは一度も動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요일을 하나 이상 골라주세요. 요일을 안 고르면 이 규칙은 한 번도 켜지지 않아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha pelo menos um dia. Sem nenhum dia, esta regra nunca funciona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите хотя бы один день. Без дней это правило не сработает ни разу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรุณาเลือกอย่างน้อยหนึ่งวัน ถ้าไม่เลือกวันเลย กฎนี้จะไม่ทำงานสักครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn ít nhất một ngày. Không chọn ngày nào thì quy tắc này không bao giờ chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少选一天。一天都不选，这条规则永远不会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請至少選一天。一天都不選，這條規則永遠不會生效。"
          }
        }
      }
    },
