          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il luogo è salvato. Vale da solo appena il telefono di tuo figlio si collega."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所を保存しました。お子さんの端末がつながれば自動で反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소를 저장했어요. 아이 폰이 연결되면 저절로 적용돼요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O lugar está salvo. Ele passa a valer sozinho quando o celular do seu filho conectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Место сохранено. Оно заработает само, как только телефон ребёнка подключится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกสถานที่แล้ว เมื่อมือถือของลูกเชื่อมต่อจะมีผลเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu địa điểm. Khi điện thoại của con kết nối thì nó tự có hiệu lực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地点已保存。孩子手机连上后会自动生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地點已儲存。孩子手機連上後會自動生效。"
          }
        }
      }
    },
    "place_sync_pending": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht beim Handy Ihres Kindes angekommen. Es arbeitet weiter mit den alten Orten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not delivered to your child's phone yet. It is still using the old places."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no ha llegado al teléfono de tu hijo. Sigue usando los lugares antiguos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore arrivé sur le téléphone de votre enfant. Il utilise toujours les anciens lieux."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum sampai ke ponsel anak Anda. Ponselnya masih memakai tempat yang lama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora arrivato al telefono di tuo figlio. Usa ancora i luoghi vecchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだお子さんの端末に届いていません。いまも以前の場所でお知らせしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 애기폰에 전달되지 않았어요. 애기폰은 지금도 예전 장소대로 알려요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não chegou ao celular do seu filho. Ele continua com os lugares antigos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До телефона ребёнка ещё не дошло. Он всё ещё работает по старым местам."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ถึงมือถือของลูก ตอนนี้ยังแจ้งตามสถานที่เดิมอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa tới điện thoại của con. Máy vẫn đang báo theo địa điểm cũ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
