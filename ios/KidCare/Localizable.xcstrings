    "alert_command_failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Anfrage an das Handy Ihres Kindes ist fehlgeschlagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A request to your child's phone failed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló una petición enviada al teléfono de tu hijo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une demande envoyée au téléphone de votre enfant a échoué"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan ke ponsel anak Anda gagal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una richiesta inviata al telefono di tuo figlio non è riuscita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さんの端末に送ったリクエストが失敗しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애기폰에 보낸 요청이 실패했어요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pedido enviado ao celular do seu filho falhou"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос на телефон ребёнка не прошёл"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำสั่งที่ส่งไปยังมือถือของลูกล้มเหลว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một yêu cầu gửi tới điện thoại của con đã thất bại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送到孩子手机的请求失败了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送到孩子手機的要求失敗了"
          }
        }
      }
    },
    "alert_empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Meldungen.\nLegen Sie im Tab „Orte“ die Schule oder den Kurs fest,\ndann erscheinen Ankünfte hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No updates yet.\nPick a school or academy on the Places tab\nand arrivals will show up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay avisos.\nGuarda el colegio o la academia en la pestaña Lugares\ny las llegadas aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de nouvelles.\nEnregistrez l'école ou le cours dans l'onglet Lieux\net les arrivées apparaîtront ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada kabar.\nSimpan sekolah atau tempat les di tab Tempat,\nlalu kedatangan akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna novità.\nSalva la scuola o il corso nella scheda Luoghi\ne gli arrivi compariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだお知らせはありません。\n「場所」タブで学校や塾を登録すると\n到着や出発がここに集まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 온 알림이 없어요.\n'장소' 탭에서 학교나 학원을 정해두면\n아이가 도착하거나 나설 때 여기에 쌓여요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há avisos.\nSalve a escola ou o curso na aba Lugares\ne as chegadas vão aparecer aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока новостей нет.\nУкажите школу или кружок на вкладке «Места»,\nи приходы будут появляться здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีข่าวคราว\nตั้งโรงเรียนหรือที่เรียนพิเศษในแท็บสถานที่\nแล้วการมาถึงจะมาปรากฏตรงนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có tin nào.\nHãy lưu trường học hay lớp học thêm ở thẻ Địa điểm,\nrồi các lần con đến sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有消息。\n在“地点”标签里设置学校或补习班，\n孩子到达或离开时就会出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有通知。\n在「地點」分頁設定學校或補習班，\n孩子抵達或離開時就會出現在這裡。"
          }
        }
      }
    },
    "alert_error_format": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldungen konnten nicht geladen werden\n%1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load updates\n%1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los avisos\n%1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les nouvelles\n%1$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak bisa memuat kabar\n%1$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare le novità\n%1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お知らせを読み込めませんでした\n%1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 불러오지 못했어요\n%1$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os avisos\n%1$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить новости\n%1$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดข่าวคราวไม่ได้\n%1$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tải được tin\n%1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载消息\n%1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入通知\n%1$@"
          }
        }
      }
    },
    "alert_low_battery": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Handy Ihres Kindes hat wenig Akku"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your child's phone is low on battery"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al teléfono de tu hijo le queda poca batería"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléphone de votre enfant a peu de batterie"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baterai ponsel anak Anda tinggal sedikit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telefono di tuo figlio ha poca batteria"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さんの端末のバッテリーが残りわずかです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애기폰 배터리가 얼마 안 남았어요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular do seu filho está com pouca bateria"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На телефоне ребёнка мало заряда"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มือถือของลูกแบตเตอรี่เหลือน้อย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại của con sắp hết pin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "孩子手机的电量不多了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "孩子手機的電量不多了"
          }
        }
      }
    },
    "alert_no_family": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Familie wurde nicht gefunden. Bitte schließen Sie die App und öffnen Sie sie erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not find your family. Please close the app and open it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró tu familia. Cierra la aplicación y vuelve a abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre famille est introuvable. Fermez l'application et rouvrez-la."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluarga tidak ditemukan. Tutup aplikasi lalu buka lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Famiglia non trovata. Chiudi l'app e riaprila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家族の情報が見つかりませんでした。アプリを閉じてもう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족 정보를 찾지 못했어요. 앱을 껐다가 다시 열어주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não encontramos a sua família. Feche o aplicativo e abra de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семья не найдена. Закройте приложение и откройте снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบข้อมูลครอบครัว กรุณาปิดแอปแล้วเปิดใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy gia đình. Hãy đóng ứng dụng rồi mở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到家庭信息。请关闭应用后重新打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到家庭資訊。請關閉應用程式後重新開啟。"
          }
        }
      }
    },
    "alert_notification_denied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind aus, deshalb lässt sich das nicht einschalten. Gehen Sie zu Einstellungen → Apps → KidCare → Benachrichtigungen und schalten Sie sie ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off, so this cannot be enabled. Go to phone Settings → Apps → KidCare → Notifications and turn them on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas, así que no se puede activar. Ve a Ajustes del teléfono → Aplicaciones → KidCare → Notificaciones y actívalas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées, impossible d'activer ceci. Allez dans Paramètres du téléphone → Applications → KidCare → Notifications et activez-les."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi sedang mati, jadi ini tidak bisa dinyalakan. Buka Setelan ponsel → Aplikasi → KidCare → Notifikasi lalu nyalakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono spente, quindi non si può attivare. Vai in Impostazioni del telefono → App → KidCare → Notifiche e attivale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフになっているため有効にできません。端末の設定→アプリ→KidCare→通知でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 권한이 꺼져 있어서 켤 수 없어요. 폰 설정 → 앱 → '우리아이 지킴이' → 알림에서 켜주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desligadas, então não dá para ativar. Vá em Configurações do celular → Aplicativos → KidCare → Notificações e ative."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления выключены, поэтому включить не получится. Откройте Настройки телефона → Приложения → KidCare → Уведомления и включите их."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนปิดอยู่จึงเปิดไม่ได้ ไปที่ตั้งค่าเครื่อง → แอป → KidCare → การแจ้งเตือน แล้วเปิด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo đang tắt nên không bật được. Vào Cài đặt điện thoại → Ứng dụng → KidCare → Thông báo rồi bật lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭，无法开启。请到手机设置→应用→KidCare→通知里打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已關閉，無法開啟。請到手機設定→應用程式→KidCare→通知裡打開。"
          }
        }
      }
    },
    "alert_notification_more": {
      "extractionState": "manual",
