    "schedule_no_family": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Familie wurde nicht gefunden. Bitte schließen Sie die App und öffnen Sie sie erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not find your family. Please close the app and open it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró tu familia. Cierra la aplicación y vuelve a abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre famille est introuvable. Fermez l'application et rouvrez-la."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluarga tidak ditemukan. Tutup aplikasi lalu buka lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Famiglia non trovata. Chiudi l'app e riaprila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家族の情報が見つかりませんでした。アプリを閉じてもう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족 정보를 찾지 못했어요. 앱을 껐다가 다시 열어주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não encontramos a sua família. Feche o aplicativo e abra de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семья не найдена. Закройте приложение и откройте снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบข้อมูลครอบครัว กรุณาปิดแอปแล้วเปิดใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy gia đình. Hãy đóng ứng dụng rồi mở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
