    "perm_denied_permanently": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde gerade abgelehnt, deshalb kann dieser Bildschirm nicht noch einmal fragen. Tippen Sie auf „In den Einstellungen einschalten“, um zu den App-Einstellungen zu gehen, und schalten Sie die Berechtigung dort ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was just denied, so this screen cannot ask again. Tap 'Turn on in Settings' to open the app settings and turn the permission on there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se acaba de denegar, así que esta pantalla no puede volver a preguntar. Toca «Activar en Ajustes» para ir a los ajustes de la aplicación y activa el permiso allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela vient d'être refusé, cet écran ne peut donc plus le demander. Appuyez sur « Activer dans les paramètres » pour aller aux paramètres de l'application et activez l'autorisation là-bas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baru saja ditolak, jadi layar ini tidak bisa bertanya lagi. Ketuk «Nyalakan di Setelan» untuk membuka setelan aplikasi, lalu nyalakan izinnya di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È appena stato negato, quindi questa schermata non può chiederlo di nuovo. Tocca «Attiva nelle impostazioni» per andare alle impostazioni dell'app e attiva lì il permesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たったいま拒否されたのでこの画面からはもう一度聞けません。「設定で有効にする」を押すとアプリの設定に移動します。そこで権限をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 거부돼서 이 화면에서는 다시 물어볼 수 없어요. '설정에서 켜기'를 누르면 앱 설정으로 가요. 거기서 권한을 켜주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabou de ser negado, então esta tela não pode perguntar de novo. Toque em «Ativar nas configurações» para ir às configurações do aplicativo e ative a permissão lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только что отказали, поэтому с этого экрана спросить снова нельзя. Нажмите «Включить в настройках», чтобы перейти в настройки приложения, и включите разрешение там."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่งถูกปฏิเสธไป หน้านี้จึงถามอีกไม่ได้ กด «เปิดในตั้งค่า» เพื่อไปที่ตั้งค่าแอป แล้วเปิดสิทธิ์ที่นั่น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vừa bị từ chối nên màn hình này không hỏi lại được. Bấm «Bật trong Cài đặt» để sang phần cài đặt ứng dụng rồi bật quyền ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刚才被拒绝了，这个画面无法再询问。按“到设置里打开”会进入应用设置，请在那里打开权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剛才被拒絕了，這個畫面無法再詢問。按「到設定裡開啟」會進入應用程式設定，請在那裡開啟權限。"
          }
        }
      }
    },
    "perm_dnd_reason": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Berechtigung erlaubt einem Elternteil, Ton und Vibration zu ändern. Suchen Sie KidCare in der Liste und schalten Sie es ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This lets a parent change the sound and vibration. Find KidCare in the list and turn it on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este permiso deja que un padre cambie el sonido y la vibración. Busca KidCare en la lista y actívalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette autorisation permet à un parent de changer le son et la vibration. Trouvez KidCare dans la liste et activez-le."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin ini membuat orang tua bisa mengubah suara dan getar. Cari KidCare di daftarnya lalu nyalakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo permesso lascia che un genitore cambi suono e vibrazione. Trova KidCare nell'elenco e attivalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護者が音やバイブを変えられるようにする権限です。一覧からKidCareを探してオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부모님이 소리·진동을 바꿔줄 수 있게 하는 권한이에요. 목록에서 '우리아이 지킴이'를 찾아 켜주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta permissão deixa um responsável mudar o som e a vibração. Procure KidCare na lista e ative."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это разрешение позволяет родителю менять звук и вибрацию. Найдите в списке KidCare и включите."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์นี้ทำให้ผู้ปกครองเปลี่ยนเสียงและการสั่นได้ กรุณาหา KidCare ในรายการแล้วเปิด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền này cho phép bố mẹ đổi âm thanh và rung. Hãy tìm KidCare trong danh sách rồi bật lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个权限让家长可以更改声音和震动。请在列表里找到KidCare并打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個權限讓家長可以變更聲音和震動。請在清單裡找到KidCare並開啟。"
          }
        }
      }
    },
