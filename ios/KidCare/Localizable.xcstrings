    "child_sharing_on": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Eltern können sehen, wo du gerade bist.\nDamit sie dich schnell finden, wenn du dich verläufst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your parents can see where you are right now.\nSo they can find you quickly if you get lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus padres pueden ver dónde estás ahora mismo.\nAsí te encuentran enseguida si te pierdes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes parents peuvent voir où tu es en ce moment.\nComme ça ils te retrouvent vite si tu te perds."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang tuamu bisa melihat kamu sedang di mana.\nSupaya cepat menemukanmu kalau kamu tersesat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi genitori possono vedere dove sei adesso.\nCosì ti trovano subito se ti perdi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまどこにいるかを保護者が見られます。\n道に迷ってもすぐ迎えに行けるように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 내가 어디 있는지 엄마 아빠가 볼 수 있어요.\n길을 잃어도 금방 찾아올 수 있게요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus pais podem ver onde você está agora.\nAssim eles te acham rápido se você se perder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Родители видят, где ты сейчас.\nЧтобы быстро найти тебя, если ты потеряешься."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พ่อแม่เห็นได้ว่าตอนนี้หนูอยู่ที่ไหน\nเผื่อหลงทางจะได้มารับได้เร็ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bố mẹ có thể thấy con đang ở đâu.\nĐể tìm con thật nhanh nếu con lạc đường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "爸爸妈妈可以看到我现在在哪里。\n就算迷路也能很快找到我。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "爸爸媽媽可以看到我現在在哪裡。\n就算迷路也能很快找到我。"
          }
        }
      }
    },
