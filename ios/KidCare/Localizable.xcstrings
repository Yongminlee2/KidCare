{
  "sourceLanguage": "ko",
  "strings": {
    "child_default_name": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이"
          }
        }
      }
    },
    "control_alarm_cancel": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맞춰둔 알람 끄기"
          }
        }
      }
    },
    "control_alarm_hint_detail": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고른 시각에 애기폰에서 한 번만 울려요. 이미 지난 시각이면 다음 날 그 시각에 울립니다 — 오늘인지 내일인지는 애기폰 시계로 정해져요. 알람이 걸리면 애기폰 상태바에 시계 모양이 떠서 아이도 알 수 있고, 5분이 지나면 저절로 멈춰요."
          }
        }
      }
    },
    "control_alarm_label_hint": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 이름 (예: 학원 가야 해)"
          }
        }
      }
    },
    "control_alarm_picker_title": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 시에 울릴까요?"
          }
        }
      }
    },
    "control_alarm_set": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시각에 알람 맞추기"
          }
        }
      }
    },
    "control_alarm_state_confirmed": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애기폰에 %1$@ 알람이 맞춰져 있어요"
          }
        }
      }
    },
    "control_alarm_state_labeled": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ '%2$@'"
          }
        }
      }
    },
    "control_alarm_state_pending": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 알람을 보냈어요 · 애기폰 대답을 기다리는 중이에요"
          }
        }
      }
    },
    "control_command_done": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        }
      }
    },
    "control_command_queued": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 안 갔어요. 인터넷이 연결되면 그때 애기폰으로 가서 실행돼요 — 그 사이 상황이 달라졌을 수 있어요."
          }
        }
      }
    },
    "control_command_sending": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전달 중…"
          }
        }
      }
    },
    "control_command_timeout": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애기폰이 응답하지 않아요"
          }
        }
      }
    },
    "control_command_timeout_format": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애기폰이 응답하지 않아요\n%1$@"
          }
        }
      }
    },
    "control_error_alarm_exact_denied": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애기폰에서 '알람 및 리마인더' 권한이 꺼져 있어 알람을 맞추지 못했어요. 아이 폰 설정 → 앱 → '우리아이 지킴이' → 알람 및 리마인더에서 켜주세요."
          }
        }
      }
    },
    "control_error_child_failed": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이 폰이 이 명령을 처리하지 못했어요."
          }
        }
      }
    },
    "control_error_message_notification_off": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이 폰에서 알림이 꺼져 있어 메시지를 띄우지 못했어요. 아이 폰 설정 → 앱 → '우리아이 지킴이' → 알림에서 켜주세요."
          }
        }
      }
    },
    "control_error_ringer_denied": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이 폰에서 소리 설정 권한이 꺼져 있어요. 아이 폰 설정에서 켜야 바꿀 수 있어요."
          }
        }
      }
    },
