            "state": "translated",
            "value": "公休日休息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "國定假日休息"
          }
        }
      }
    },
    "schedule_holiday_unknown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Handy konnte die Feiertage nicht berechnen. Auch bei eingeschaltetem Schalter zählen nur die Wochentage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone could not work out the holiday dates. Even with the switch on, only the days of the week are used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono no pudo calcular las fechas de los festivos. Aunque enciendas el interruptor, solo se usan los días de la semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone n'a pas pu calculer les dates des jours fériés. Même avec l'interrupteur allumé, seuls les jours de la semaine comptent."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel ini tidak bisa menghitung tanggal hari libur. Meski sakelarnya menyala, hanya hari dalam seminggu yang dipakai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono non è riuscito a calcolare le date dei giorni festivi. Anche con l'interruttore acceso contano solo i giorni della settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末では祝日の日付を計算できませんでした。オンにしても曜日だけで動きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 공휴일 날짜를 계산하지 못했어요. 스위치를 켜도 요일대로만 돌아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este celular não conseguiu calcular as datas dos feriados. Mesmo com a chave ligada, só os dias da semana são usados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот телефон не смог вычислить даты праздников. Даже с включённым переключателем считаются только дни недели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องนี้คำนวณวันหยุดราชการไม่ได้ ถึงเปิดสวิตช์ก็จะทำงานตามวันในสัปดาห์เท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy này không tính được ngày lễ. Dù bật công tắc thì cũng chỉ chạy theo ngày trong tuần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台手机算不出公休日的日期。就算打开开关，也只按星期运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機算不出國定假日的日期。就算打開開關，也只依星期運作。"
          }
        }
      }
    },
