    "perm_notification_reason": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird gebraucht, um Nachrichten von deinen Eltern zu bekommen und zu zeigen, dass der Standort geteilt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to receive messages from your parents and to show that the location is being shared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace falta para recibir los mensajes de tus padres y para mostrar que se está compartiendo la ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour recevoir les messages de tes parents et pour montrer que la position est partagée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperlukan untuk menerima pesan orang tuamu dan menunjukkan bahwa lokasi sedang dibagikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve per ricevere i messaggi dei tuoi genitori e per mostrare che la posizione è condivisa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護者からのメッセージを受け取り、位置を共有中であることを表示するために必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부모님이 보낸 메시지를 받고, 위치 공유 중이라는 표시를 띄우기 위해 필요해요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso para receber os recados dos seus pais e para mostrar que a localização está sendo compartilhada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно, чтобы получать сообщения от родителей и показывать, что геопозиция передаётся."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำเป็นเพื่อรับข้อความจากพ่อแม่ และเพื่อแสดงว่ากำลังแชร์ตำแหน่งอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần có để nhận lời nhắn của bố mẹ và để hiện rằng vị trí đang được chia sẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了接收爸爸妈妈的留言，并显示正在共享位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了接收爸爸媽媽的留言，並顯示正在分享位置。"
          }
        }
      }
    },
