    "child_play_services_fixable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Google-Play-Dienste fehlen oder sind zu alt, deshalb kann der Standort nicht gesendet werden.\nTippe unten auf die Schaltfläche, um das zu beheben. (Nachrichten und Tonänderungen gehen weiterhin.)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play services is missing or too old, so location cannot be sent.\nTap the button below to fix it. (Messages and sound changes still work.)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan los servicios de Google Play o son muy antiguos, así que no se puede enviar la ubicación.\nToca el botón de abajo para arreglarlo. (Los mensajes y los cambios de sonido siguen funcionando.)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les services Google Play sont absents ou trop anciens, la position ne peut pas être envoyée.\nAppuie sur le bouton ci-dessous pour réparer. (Les messages et les changements de son marchent toujours.)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan Google Play tidak ada atau terlalu lama, jadi lokasi tidak bisa dikirim.\nKetuk tombol di bawah untuk memperbaikinya. (Pesan dan penggantian suara tetap jalan.)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I servizi Google Play mancano o sono troppo vecchi, quindi la posizione non può essere inviata.\nTocca il pulsante qui sotto per ripararli. (Messaggi e cambi di suono funzionano lo stesso.)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末のGoogle Play開発者サービスが無いか古すぎて位置を送れません。\n下のボタンで直せます。（メッセージの受信と音の変更はそのまま使えます。）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰의 'Google Play 서비스'가 없거나 너무 오래돼서 위치를 보낼 수 없어요.\n아래 버튼을 누르면 고칠 수 있어요. (메시지 받기와 소리 바꾸기는 그대로 돼요.)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os serviços do Google Play estão faltando ou muito antigos, então não dá para enviar a localização.\nToque no botão abaixo para corrigir. (Recados e mudanças de som continuam funcionando.)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервисов Google Play нет или они слишком старые, поэтому геопозицию не отправить.\nНажми кнопку ниже, чтобы починить. (Сообщения и смена звука работают как раньше.)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการ Google Play ไม่มีหรือเก่าเกินไป จึงส่งตำแหน่งไม่ได้\nกดปุ่มข้างล่างเพื่อซ่อม (การรับข้อความและการเปลี่ยนเสียงยังใช้ได้ปกติ)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ Google Play không có hoặc quá cũ nên không gửi được vị trí.\nBấm nút bên dưới để sửa. (Nhận lời nhắn và đổi âm thanh vẫn dùng được.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机上的Google Play服务缺失或太旧，无法发送位置。\n点下面的按钮可以修复。（接收留言和更改声音仍然可用。）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機上的Google Play服務缺少或太舊，無法傳送位置。\n按下面的按鈕可以修復。（接收留言和變更聲音仍然可用。）"
          }
        }
      }
    },
    "child_play_services_unfixable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Handy gibt es keine Google-Play-Dienste, deshalb kann der Standort nicht gesendet werden.\nZeig diesen Bildschirm deinen Eltern. (Nachrichten und Tonänderungen gehen weiterhin.)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone has no Google Play services, so location cannot be sent.\nShow this screen to your parents. (Messages and sound changes still work.)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono no tiene los servicios de Google Play, así que no se puede enviar la ubicación.\nEnséñales esta pantalla a tus padres. (Los mensajes y los cambios de sonido siguen funcionando.)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone n'a pas les services Google Play, la position ne peut pas être envoyée.\nMontre cet écran à tes parents. (Les messages et les changements de son marchent toujours.)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel ini tidak punya layanan Google Play, jadi lokasi tidak bisa dikirim.\nTunjukkan layar ini ke orang tuamu. (Pesan dan penggantian suara tetap jalan.)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono non ha i servizi Google Play, quindi la posizione non può essere inviata.\nMostra questa schermata ai tuoi genitori. (Messaggi e cambi di suono funzionano lo stesso.)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末にはGoogle Play開発者サービスが無いため位置を送れません。\nこの画面を保護者に見せてください。（メッセージの受信と音の変更はそのまま使えます。）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폰에는 'Google Play 서비스'가 없어서 위치를 보낼 수 없어요.\n이 화면을 엄마 아빠께 보여주세요. (메시지 받기와 소리 바꾸기는 그대로 돼요.)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este celular não tem os serviços do Google Play, então não dá para enviar a localização.\nMostre esta tela para os seus pais. (Recados e mudanças de som continuam funcionando.)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом телефоне нет сервисов Google Play, поэтому геопозицию не отправить.\nПокажи этот экран родителям. (Сообщения и смена звука работают как раньше.)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มือถือเครื่องนี้ไม่มีบริการ Google Play จึงส่งตำแหน่งไม่ได้\nเอาหน้าจอนี้ให้พ่อแม่ดูนะ (การรับข้อความและการเปลี่ยนเสียงยังใช้ได้ปกติ)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại này không có dịch vụ Google Play nên không gửi được vị trí.\nHãy cho bố mẹ xem màn hình này. (Nhận lời nhắn và đổi âm thanh vẫn dùng được.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台手机没有Google Play服务，无法发送位置。\n请把这个画面给爸爸妈妈看。（接收留言和更改声音仍然可用。）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機沒有Google Play服務，無法傳送位置。\n請把這個畫面拿給爸爸媽媽看。（接收留言和變更聲音仍然可用。）"
          }
        }
      }
    },
