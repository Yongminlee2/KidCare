    "place_editor_notify_none_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind beide aus, meldet dieser Ort nichts. Der Ort bleibt gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With both off, this place sends no alerts. The place itself stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con los dos apagados, este lugar no envía avisos. El lugar sigue guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux éteints, ce lieu n'envoie aucun avis. Le lieu reste enregistré."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau keduanya mati, tempat ini tidak mengirim pemberitahuan. Tempatnya tetap tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con tutti e due spenti questo luogo non manda avvisi. Il luogo resta salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらもオフにするとこの場所ではお知らせが届きません。場所はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다 꺼두면 이 장소로는 알림이 오지 않아요. 장소는 그대로 남아 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com os dois desligados, este lugar não envia avisos. O lugar continua salvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если оба выключены, это место не шлёт уведомлений. Само место остаётся."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าปิดทั้งสองอย่าง สถานที่นี้จะไม่แจ้งอะไรเลย แต่สถานที่ยังอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt cả hai thì chỗ này không báo gì. Địa điểm vẫn được giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个都关掉，这个地点就不会有通知。地点本身仍然保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個都關掉，這個地點就不會有通知。地點本身仍然保留。"
          }
        }
      }
    },
