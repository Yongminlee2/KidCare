    "pairing_wrong_role": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code gehört nicht zur gewählten Rolle. Prüfen Sie, welcher Code für das Kind und welcher für einen Elternteil ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code is not for the role you chose. Check which code is for the child and which is for a parent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código no es para el papel que elegiste. Mira cuál es el del hijo y cuál el del padre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code ne correspond pas au rôle choisi. Vérifiez lequel est pour l'enfant et lequel pour un parent."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode ini bukan untuk peran yang Anda pilih. Periksa mana yang untuk anak dan mana yang untuk orang tua."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice non è del ruolo che hai scelto. Controlla qual è quello del bambino e quale quello del genitore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この番号は選んだ役割の招待番号ではありません。お子さん用と保護者用のどちらか確かめてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 번호는 선택한 역할의 초대 번호가 아니에요. 아이용과 보호자용 번호를 확인해주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código não é do papel que você escolheu. Veja qual é o da criança e qual é o do responsável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот номер не для выбранной роли. Проверьте, какой номер для ребёнка, а какой для родителя."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสนี้ไม่ใช่ของบทบาทที่เลือก กรุณาดูว่าอันไหนของลูกและอันไหนของผู้ปกครอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã này không phải của vai trò bạn đã chọn. Hãy xem mã nào cho con và mã nào cho phụ huynh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个号码不是您所选身份的邀请号码。请确认哪个是孩子用的、哪个是家长用的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個號碼不是您所選身分的邀請號碼。請確認哪個是孩子用的、哪個是家長用的。"
          }
        }
      }
    },
    "perm_activity_reason": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn bekannt ist, ob Ihr Kind geht oder steht, kann der Standort im Stehen seltener geprüft werden, und das spart Akku."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knowing whether your child is walking or still lets the app check the location less often while still, which saves battery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saber si tu hijo camina o está quieto permite consultar la ubicación con menos frecuencia mientras está quieto, y así se ahorra batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Savoir si votre enfant marche ou reste immobile permet de vérifier la position moins souvent quand il ne bouge pas, ce qui économise la batterie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau ketahuan anak sedang berjalan atau diam, saat diam lokasinya bisa diperiksa lebih jarang, jadi baterai lebih hemat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapere se tuo figlio cammina o sta fermo permette di controllare la posizione meno spesso quando sta fermo, e così si risparmia batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歩いているか止まっているかが分かると、止まっているときは位置を確認する回数を減らしてバッテリーを節約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걷고 있는지 가만히 있는지 알면, 가만히 있을 때는 위치를 덜 자주 확인해서 배터리를 아낄 수 있어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saber se o seu filho está andando ou parado deixa o aplicativo checar a localização menos vezes enquanto ele está parado, e isso economiza bateria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда известно, идёт ребёнок или стоит, во время стоянки место можно проверять реже — так экономится батарея."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้ารู้ว่าลูกกำลังเดินหรืออยู่นิ่ง ตอนอยู่นิ่งก็ตรวจตำแหน่งถี่น้อยลงได้ ช่วยประหยัดแบต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biết được con đang đi hay đứng yên thì lúc đứng yên có thể kiểm tra vị trí thưa hơn, nhờ đó tiết kiệm pin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "知道孩子是在走路还是停着，停着的时候就能少查几次位置，省电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "知道孩子是在走路還是停著，停著的時候就能少查幾次位置，省電。"
          }
        }
      }
    },
