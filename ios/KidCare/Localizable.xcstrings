    "guardian_disconnect_banner": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die %1$@ gesendete Anfrage hat das Handy Ihres Kindes noch nicht geantwortet\nÖffnen Sie die App KidCare einmal auf seinem Handy, dann verbindet es sich wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your child's phone has not answered the request sent %1$@\nOpen the KidCare app once on your child's phone and it will connect again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono de tu hijo aún no ha respondido a la petición enviada %1$@\nAbre una vez la aplicación KidCare en su teléfono y volverá a conectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléphone de votre enfant n'a pas encore répondu à la demande envoyée %1$@\nOuvrez une fois l'application KidCare sur son téléphone et la connexion reviendra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan yang dikirim %1$@ belum dijawab ponsel anak Anda\nBuka aplikasi KidCare sekali di ponselnya, sambungan akan pulih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telefono di tuo figlio non ha ancora risposto alla richiesta inviata %1$@\nApri una volta l'app KidCare sul suo telefono e si ricollegherà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@に送ったリクエストにお子さんの端末がまだ答えていません\nお子さんの端末でKidCareを一度開いてください。そうすればまたつながります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 보낸 요청에 애기폰이 아직 대답하지 않았어요\n아이 폰에서 '우리아이 지킴이' 앱을 한 번 열어주세요. 그러면 다시 이어져요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular do seu filho ainda não respondeu ao pedido enviado %1$@\nAbra o aplicativo KidCare uma vez no celular dele e a conexão volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На запрос, отправленный %1$@, телефон ребёнка ещё не ответил\nОткройте на его телефоне приложение KidCare один раз, и связь восстановится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำสั่งที่ส่งเมื่อ %1$@ มือถือของลูกยังไม่ตอบกลับ\nลองเปิดแอป KidCare บนเครื่องของลูกสักครั้ง แล้วจะเชื่อมต่อกลับมา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu gửi %1$@ vẫn chưa được điện thoại của con trả lời\nHãy mở ứng dụng KidCare một lần trên máy của con, kết nối sẽ trở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@发送的请求，孩子手机还没有回应\n请在孩子手机上打开一次KidCare，就会重新连上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@傳送的要求，孩子手機還沒有回應\n請在孩子手機上開啟一次KidCare，就會重新連上。"
          }
        }
      }
    },
