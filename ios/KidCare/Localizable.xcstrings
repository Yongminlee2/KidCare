    "place_editor_name_required": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte schreiben Sie einen Namen. Er erscheint in der Meldung, etwa „Bei ○○ angekommen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please write a name. This is the name that shows in the alert, as in 'Arrived at ○○'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un nombre. Es el que sale en el aviso, como «Ha llegado a ○○»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez un nom. C'est celui qui apparaît dans l'avis, comme « Arrivé à ○○ »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis namanya. Nama ini yang muncul di pemberitahuan, seperti «Sampai di ○○»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi un nome. È quello che compare nell'avviso, come «Arrivato a ○○»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を書いてください。お知らせに「○○に到着しました」と出る名前です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 적어주세요. 알림에 '○○에 도착했어요'로 뜨는 이름이에요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva um nome. É o nome que aparece no aviso, como «Chegou em ○○»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишите название. Оно появится в уведомлении, например «Пришёл в ○○»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรุณาใส่ชื่อ เป็นชื่อที่จะขึ้นในแจ้งเตือนว่า «ถึง ○○ แล้ว»"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy viết tên. Đây là tên hiện trong thông báo, kiểu «Đã đến ○○»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请写一个名称。通知里会显示成“已到达○○”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請寫一個名稱。通知裡會顯示成「已抵達○○」。"
          }
        }
      }
    },
    "place_editor_no_child_location": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort des Kinderhandys ist noch nicht bekannt, deshalb ist die Karte weit aufgezogen. Bitte von Hand zum Ort schieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your child's location is not known yet, so the map opened wide. Please move it by hand to find the place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se sabe dónde está el teléfono de tu hijo, así que el mapa se abrió muy abierto. Muévelo con la mano para encontrar el sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ne connaît pas encore la position du téléphone de votre enfant, la carte s'est donc ouverte en grand. Déplacez-la à la main pour trouver le lieu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi ponsel anak Anda belum diketahui, jadi petanya terbuka lebar. Geser dengan tangan untuk mencari tempatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione del telefono di tuo figlio non si conosce ancora, quindi la mappa si è aperta larga. Spostala a mano per trovare il posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さんの端末の位置がまだ分からないので地図が広く開きました。手で動かして探してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이 폰 위치를 아직 몰라서 지도가 넓게 열렸어요. 손으로 옮겨 찾아주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não sabemos onde está o celular do seu filho, então o mapa abriu bem aberto. Mova com a mão para achar o lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где телефон ребёнка, пока неизвестно, поэтому карта открылась широко. Подвиньте её рукой и найдите место."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่รู้ตำแหน่งมือถือของลูก แผนที่จึงเปิดกว้าง กรุณาเลื่อนหาด้วยมือ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa biết điện thoại của con ở đâu nên bản đồ mở rất rộng. Hãy tự kéo để tìm chỗ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还不知道孩子手机的位置，所以地图开得很大。请用手移动来找。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還不知道孩子手機的位置，所以地圖開得很大。請用手移動來找。"
          }
        }
      }
    },
