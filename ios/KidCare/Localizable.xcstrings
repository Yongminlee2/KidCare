            "value": "Alarme de %1$@ enviado · esperando a resposta do celular do seu filho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будильник на %1$@ отправлен · ждём ответа от телефона ребёнка"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งนาฬิกาปลุกเวลา %1$@ แล้ว · กำลังรอมือถือของลูกตอบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gửi báo thức lúc %1$@ · đang chờ điện thoại của con trả lời"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送%1$@的闹钟 · 正在等孩子手机回应"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已傳送%1$@的鬧鐘 · 正在等孩子手機回應"
          }
        }
      }
    },
