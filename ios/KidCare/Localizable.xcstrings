    "place_delete_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nNach dem Löschen gibt es keine Meldung mehr, wenn hier angekommen oder weggegangen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nOnce deleted, arriving or leaving here will no longer send an alert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nUna vez borrado, llegar o salir de aquí ya no enviará ningún aviso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nUne fois supprimé, arriver ici ou en partir n'enverra plus d'avis."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nSetelah dihapus, sampai atau keluar dari sini tidak akan diberitahukan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nUna volta eliminato, arrivare o uscire da qui non manderà più nessun avviso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\n削除するとここに到着しても出発してもお知らせが届きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\n지우면 이곳에 도착하거나 나서도 알림이 오지 않아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nDepois de excluir, chegar ou sair daqui não vai mais gerar aviso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nПосле удаления приход сюда и уход отсюда больше не будут приходить уведомлением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nลบแล้วจะไม่มีแจ้งเตือนตอนมาถึงหรือออกจากที่นี่อีก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nXóa rồi thì đến hay rời chỗ này cũng không báo nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\n删除后，到达或离开这里都不会再通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\n刪除後，抵達或離開這裡都不會再通知。"
          }
        }
      }
    },
