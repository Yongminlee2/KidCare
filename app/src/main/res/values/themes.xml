<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.KidCare" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sky</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/sky_soft</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>

        <item name="colorSecondary">@color/apricot</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/apricot_soft</item>
        <item name="colorOnSecondaryContainer">@color/on_apricot_soft</item>

        <item name="colorTertiary">@color/grass</item>
        <item name="colorOnTertiary">@color/on_accent</item>
        <item name="colorTertiaryContainer">@color/grass_soft</item>
        <item name="colorOnTertiaryContainer">@color/ink</item>

        <item name="colorError">@color/berry_ink</item>
        <item name="colorOnError">@color/paper_card</item>
        <item name="colorErrorContainer">@color/berry_soft</item>
        <item name="colorOnErrorContainer">@color/on_berry_soft</item>

        <item name="android:colorBackground">@color/paper</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/paper_fold</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="colorSurfaceContainerLowest">@color/paper_card</item>
        <item name="colorSurfaceContainerLow">@color/paper_card</item>
        <item name="colorSurfaceContainer">@color/paper_card</item>
        <item name="colorSurfaceContainerHigh">@color/paper_fold</item>
        <item name="colorSurfaceContainerHighest">@color/paper_fold</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorOutlineVariant">@color/line_soft</item>

        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.KidCare.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.KidCare.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.KidCare.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.KidCare.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.KidCare.ExtraLarge</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.KidCare.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.KidCare.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.KidCare.Large</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.KidCare.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.KidCare.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.KidCare.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.KidCare.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.KidCare.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.KidCare.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.KidCare.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.KidCare.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.KidCare.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.KidCare.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.KidCare.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.KidCare.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.KidCare.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.KidCare.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.KidCare.LabelSmall</item>

        <item name="materialButtonStyle">@style/Widget.KidCare.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.KidCare.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/Widget.KidCare.Card</item>
        <item name="bottomNavigationStyle">@style/Widget.KidCare.BottomNav</item>
        <item name="textInputStyle">@style/Widget.KidCare.TextField</item>

        <item name="android:statusBarColor" tools:targetApi="l">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper_card</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/light_system_bars</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>

    <style parent="" name="ShapeAppearance.KidCare.ExtraSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>
    <style parent="" name="ShapeAppearance.KidCare.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style parent="" name="ShapeAppearance.KidCare.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style parent="" name="ShapeAppearance.KidCare.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
    <style parent="" name="ShapeAppearance.KidCare.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style parent="" name="ShapeAppearance.KidCare.Pill">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance.KidCare.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">40sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="lineHeight">48sp</item><item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.KidCare.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">34sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="lineHeight">42sp</item><item name="android:letterSpacing">0.04</item>
    </style>
    <style name="TextAppearance.KidCare.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">30sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="lineHeight">38sp</item>
    </style>
    <style name="TextAppearance.KidCare.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">30sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="lineHeight">38sp</item><item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.KidCare.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">27sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="lineHeight">35sp</item><item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.KidCare.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="lineHeight">32sp</item><item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.KidCare.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">21sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="lineHeight">28sp</item>
    </style>
    <style name="TextAppearance.KidCare.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="lineHeight">26sp</item>
    </style>
    <style name="TextAppearance.KidCare.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">16sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="lineHeight">23sp</item>
    </style>
    <style name="TextAppearance.KidCare.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">17sp</item><item name="lineHeight">26sp</item>
    </style>
    <style name="TextAppearance.KidCare.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item><item name="lineHeight">23sp</item>
    </style>
    <style name="TextAppearance.KidCare.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item><item name="lineHeight">19sp</item>
    </style>
    <style name="TextAppearance.KidCare.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">15sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="lineHeight">21sp</item>
    </style>
    <style name="TextAppearance.KidCare.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="lineHeight">18sp</item>
    </style>
    <style name="TextAppearance.KidCare.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="lineHeight">16sp</item>
    </style>

    <style name="Widget.KidCare.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.KidCare.Medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.KidCare.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.KidCare.Medium</item><item name="android:textAllCaps">false</item><item name="android:minHeight">48dp</item>
    </style>
    <style name="Widget.KidCare.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="shapeAppearance">@style/ShapeAppearance.KidCare.Medium</item><item name="android:textAllCaps">false</item><item name="android:minHeight">50dp</item><item name="backgroundTint">@color/sky_soft</item><item name="android:textColor">@color/sky</item><item name="iconTint">@color/sky</item>
    </style>
    <style name="Widget.KidCare.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearance">@style/ShapeAppearance.KidCare.Medium</item><item name="android:textAllCaps">false</item><item name="android:minHeight">48dp</item>
    </style>
    <style name="Widget.KidCare.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/paper_card</item>
        <item name="shapeAppearance">@style/ShapeAppearance.KidCare.Medium</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line_soft</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.KidCare.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/paper_card</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.KidCare.BottomNav.Indicator</item>
    </style>
    <style name="Widget.KidCare.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">64dp</item><item name="android:height">34dp</item><item name="android:color">@color/sky_soft</item><item name="shapeAppearance">@style/ShapeAppearance.KidCare.Pill</item>
    </style>
    <style name="Widget.KidCare.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.KidCare.Small</item><item name="boxStrokeWidth">1dp</item><item name="boxStrokeWidthFocused">2dp</item>
    </style>
</resources>
