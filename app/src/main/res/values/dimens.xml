<?xml version="1.0" encoding="utf-8"?>
<!--
    화면 격자의 정본표.

    **왜 있나:** 이 값들이 없던 동안 파일마다 손대는 사람이 그때그때 정했고, 그 결과
    같은 앱 안에서 화면 좌우가 14·16·20dp 로, 목록 줄이 5·12·14dp 로 갈렸다. 탭을
    바꿀 때마다 왼쪽 선이 8dp 씩 튀는 것이 "삐뚤빼뚤하다"는 느낌의 정체였다.

    새 화면을 만들 때는 **여기 있는 값만** 쓴다. 새 값이 필요하면 먼저 여기 이름을
    붙이고, 그 이름이 이미 있는 것과 무엇이 다른지 한 줄로 적는다.

    지도 탭(fragment_map_timeline)은 예외로 둔다 — 그 화면은 지도 위에 카드가 떠 있는
    구조라 좌우 여백의 뜻이 다르고, 지금 모양이 좋다는 평가를 받았다.
-->
<resources>
    <!-- 화면 좌우. 머리말도 카드도 이 선에서 시작한다. -->
    <dimen name="edge">20dp</dimen>

    <!-- 목록에서 카드와 카드 사이(위아래). -->
    <dimen name="card_gap">5dp</dimen>

    <!-- 카드 안쪽 여백. -->
    <dimen name="card_pad">14dp</dimen>

    <!-- 제목 묶음과 그 아래 내용 사이. -->
    <dimen name="section_gap">24dp</dimen>

    <!-- 목록 줄 왼쪽의 동그란 스티커와 그 안의 그림. -->
    <dimen name="sticker">44dp</dimen>
    <dimen name="sticker_icon">21dp</dimen>

    <!-- 줄 끝의 아이콘 버튼(삭제 등). 손가락이 닿는 최소 크기다. -->
    <dimen name="row_icon_button">44dp</dimen>
</resources>
