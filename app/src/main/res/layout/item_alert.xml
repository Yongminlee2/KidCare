<?xml version="1.0" encoding="utf-8"?>
<!-- 알림 한 줄. item_place.xml 과 같은 카드지만 누를 것이 하나도 없다 — 읽는 목록이다.

     카드 바탕색을 레이아웃에 박아두지 않고 AlertAdapter 가 칠한다. 안 읽은 줄만
     살구빛이고 그 판정은 문서가 아니라 "화면을 연 순간"에 달려 있어서다(그 어댑터의
     unreadIds 주석). -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/edge"
    android:layout_marginVertical="@dimen/card_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/card_pad"
        android:paddingVertical="9dp">

        <ImageView
            android:id="@+id/event_icon"
            android:layout_width="@dimen/sticker"
            android:layout_height="@dimen/sticker"
            android:background="@drawable/bg_icon_soft"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/ic_tab_alert"
            app:tint="@color/sky" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

        <!-- Task 7 이 채우는 detail(배터리 몇 %, 어떤 권한). 비면 GONE 이다. -->
            <TextView
                android:id="@+id/detail_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
