<?xml version="1.0" encoding="utf-8"?>
<!--
    아이가 보는 화면. 이 앱에서 디자인이 가장 많은 일을 하는 자리다.

    아이는 이 앱을 지우고 싶어할 수도 있는 나이다. 화면에 상태 문구만 있으면 그건
    감시 프로그램의 상태창이고, 아이는 그렇게 읽는다. 그래서 화면의 절반을 새싹이에게
    준다 — 문구는 하나도 숨기지 않되(무엇을 하는 앱인지 아이가 알아야 한다는 원칙은
    ChildHomeActivity 주석 참고) 그 사실을 전하는 목소리를 바꾸는 것이다.

    ScrollView 로 감싼 이유: 큰 글꼴 설정에서 마스코트 200dp + 제목 + 설명 + 버튼이
    작은 화면 세로를 넘어선다. 그때 잘리는 것이 하필 '권한 켜러 가기' 버튼이라
    아이가 고칠 방법을 잃는다.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:minHeight="400dp"
        android:padding="32dp">

        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mascot" />

        <!-- id 가 필요해진 이유: 가족에서 빠지면 이 큰 글씨가 그대로 "이어져 있어요"라고
             말하는데, 바로 아래 줄은 "연결이 풀렸어요"라고 말한다. 한 화면의 두 줄이
             서로를 부정하면 아이는 둘 다 안 믿는다(같은 실패를 known-issues 7번에서
             한 번 겪었다). ChildHomeActivity 가 상황에 맞는 쪽으로 갈아 끼운다. -->
        <TextView
            android:id="@+id/home_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/child_home_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:id="@+id/child_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- 이 화면이 "지금 뭔가 안 되고 있다"고 말할 때마다 바로 아래에서 다음 행동을
             대는 버튼. 글자와 동작은 ChildHomeActivity 가 상황마다 갈아 끼운다
             (권한 켜러 가기 / Google Play 서비스 고치기 / 다시 연결하기).
             평소엔 안 보인다.

             셋을 각각 버튼으로 두지 않는 이유: 한 번에 하나만 뜨는 상태들이라 버튼이
             셋이면 아무 일도 안 하는 버튼 둘이 늘 함께 보인다. 아이 화면에서 그건
             "뭘 눌러야 하는지 모르겠다"와 같은 말이다. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            android:text="@string/child_go_to_permission"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
    </LinearLayout>
</ScrollView>
