<?xml version="1.0" encoding="utf-8"?>
<!-- 장소 한 장. 스티커를 누르든 글자를 누르든 고치기, 오른쪽 끝은 삭제다.
     예약 줄(item_schedule.xml)과 **같은 뼈대**를 쓴다 — 두 탭이 같은 종류의
     목록이라 다르게 생길 이유가 없다.

     왼쪽 동그라미에 장소 이름의 첫 글자를 넣는다. 그림 하나를 다섯 줄에 똑같이
     반복하는 것보다 훨씬 빨리 구분되고, 장소마다 색이 달라서 목록이 색 기둥처럼
     읽힌다 — 이 탭에서 눈이 갈 곳이 그 기둥이다. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/edge"
    android:layout_marginVertical="@dimen/card_gap"
    app:shapeAppearance="@style/ShapeAppearance.KidCare.Medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/card_pad"
        android:paddingEnd="6dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:id="@+id/row_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:baselineAligned="false"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/place_sticker"
                android:layout_width="@dimen/sticker"
                android:layout_height="@dimen/sticker"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_sticker_circle"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/detail_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_button"
            style="@style/Widget.KidCare.Button.Text"
            android:layout_width="@dimen/row_icon_button"
            android:layout_height="@dimen/row_icon_button"
            android:contentDescription="@string/place_delete"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="0dp"
            app:icon="@drawable/ic_trash"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="21dp"
            app:iconTint="@color/berry_ink" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
