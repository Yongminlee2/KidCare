<?xml version="1.0" encoding="utf-8"?>
<!-- 탭이 둘 이상이 되면서 컨테이너 하나로는 부족해졌다. 위쪽은 프래그먼트 자리,
     아래는 하단 탭이다. 컨테이너에 weight 를 줘서 탭 높이를 뺀 나머지를 전부
     차지하게 한다 — 지도가 탭 뒤로 잘려 들어가지 않게 하려는 것이다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 연결 끊김 배너. 아이 폰이 30분 넘게 아무 신호도 안 보냈을 때만 보인다
         (GuardianMainActivity.renderBanner). 프래그먼트 컨테이너 **밖**, 탭보다 위에
         두는 것이 요점이다 — 지도만 보는 부모도, 관리 탭을 연 부모도 같은 자리에서
         같은 문장을 본다. 오류 색을 쓰는 이유는 이게 "알아두면 좋은 정보"가 아니라
         "지금 위치 추적이 멈춰 있다"는 뜻이기 때문이다. -->
    <TextView
        android:id="@+id/disconnect_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorErrorContainer"
        android:padding="12dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnErrorContainer"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/guardian_bottom_nav" />
</LinearLayout>
