<?xml version="1.0" encoding="utf-8"?>
<!--
    예약 탭. 화면 하나에 판을 둘 겹쳐 두고 한 번에 하나만 보여준다.

    편집을 별도 DialogFragment 로 띄우지 않은 이유: 다이얼로그는 회전·프로세스 사망
    뒤에 자기 리스너를 잃어버려 "확인을 눌렀는데 아무 일도 안 일어나는" 화면이 되기
    쉽다(이 화면은 MaterialTimePicker 하나 때문에 이미 그 문제를 다루고 있다,
    ScheduleFragment.rebindTimePickers 주석 참고). 판을 바꾸는 방식이면 편집 내용이
    프래그먼트의 필드 + onSaveInstanceState 한 곳에만 있어 되살리기가 간단하다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================================ 목록 판 ================================ -->
    <LinearLayout
        android:id="@+id/list_pane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/edge"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/schedule_header_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />
        </LinearLayout>

        <!-- 예약이 없는 시간의 기본값.

             이게 없던 시절에는 규칙이 끝나도 마지막 모드가 그대로 남았다 — "평일 밤
             무음"을 걸면 아침이 와도 무음인 채였다. 규칙은 **언제 시작하는지만** 말할
             뿐 끝난 뒤 무엇으로 돌아갈지는 말하지 않기 때문이다. 돌아갈 자리를 여기
             한 곳에 둔다.

             공휴일 카드보다 위에 두는 이유: 이건 "예약이 없을 때"를 정하는 것이라
             모든 규칙의 바탕이고, 공휴일 스위치는 그 바탕 위에서 규칙을 쉬게 하는
             것이다. 바탕이 먼저 읽혀야 한다. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/edge"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/paper_card"
            app:shapeAppearance="@style/ShapeAppearance.KidCare.Medium"
            app:strokeColor="@color/line_soft"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/schedule_default_label"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/default_mode_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/default_mode_none"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="0dp"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="1dp"
                        android:saveEnabled="false"
                        android:text="@string/schedule_default_none"
                        android:textSize="12sp"
                        app:shapeAppearance="@style/ShapeAppearance.KidCare.Small"
                        app:strokeWidth="1.5dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/default_mode_normal"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="1dp"
                        android:saveEnabled="false"
                        android:text="@string/schedule_mode_normal"
                        android:textSize="12sp"
                        app:shapeAppearance="@style/ShapeAppearance.KidCare.Small"
                        app:strokeWidth="1.5dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/default_mode_vibrate"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="1dp"
                        android:saveEnabled="false"
                        android:text="@string/schedule_mode_vibrate"
                        android:textSize="12sp"
                        app:shapeAppearance="@style/ShapeAppearance.KidCare.Small"
                        app:strokeWidth="1.5dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/default_mode_silent"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="1dp"
                        android:saveEnabled="false"
                        android:text="@string/schedule_mode_silent"
                        android:textSize="12sp"
                        app:shapeAppearance="@style/ShapeAppearance.KidCare.Small"
                        app:strokeWidth="1.5dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 공휴일 스위치.

             규칙 목록 안이 아니라 목록 **위**에 둔 이유: 이건 규칙이 아니라 아래
             규칙 전부에 걸리는 달력이다. 목록 안에 한 줄로 넣으면 다른 규칙과 같은
             무게로 보여서, 켜고 끄면 무엇이 달라지는지가 흐려진다.

             날짜를 손으로 넣게 하지 않는다 — 설날·추석·부처님오신날은 음력이라 해마다
             옮겨 다니고 대체공휴일은 그 해 요일 배치에 따라 생겼다 없어져서, 부모가
             매년 다시 찍어야 하는 값이 된다. 앱이 계산하고, 맞게 계산했는지는 아래
             '다음 쉬는 날' 한 줄로 부모가 눈으로 확인한다. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/edge"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/berry_soft"
            app:shapeAppearance="@style/ShapeAppearance.KidCare.Medium"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_holiday"
                    app:tint="@color/berry_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/schedule_holiday_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/on_berry_soft" />

                    <TextView
                        android:id="@+id/holiday_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/schedule_holiday_subtitle"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/on_berry_soft" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/holiday_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minHeight="48dp"
                    android:saveEnabled="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 오류·저장 결과 한 줄. 평소에는 GONE. -->
        <TextView
            android:id="@+id/schedule_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/edge"
            android:paddingVertical="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <!-- "규칙은 저장됐는데 아이 폰에 아직 못 알렸다"는 줄. 이게 없으면 전달에
             실패한 규칙과 실제로 적용된 규칙이 목록에서 똑같이 보인다 — 부모는
             정해뒀다고 믿는데 아이 폰은 옛 규칙대로 도는, 이 화면에서 가장 나쁜
             실패다(ScheduleFragment.pendingSync 주석). 어느 규칙이 문제인지는
             구분하지 않는다: 깃발은 "규칙 묶음 전체를 다시 읽어라"는 신호 하나에
             달려 있어서 규칙별로 나눌 수 있는 값이 아니고, 부모가 할 수 있는 일도
             '다시 알리기' 하나라 줄 하나면 충분하다. -->
        <LinearLayout
            android:id="@+id/sync_pending_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorErrorContainer"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/edge"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/schedule_sync_pending"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnErrorContainer" />

            <!-- 글자 버튼의 기본 글자색은 colorPrimary(하늘)인데, 이 버튼만은
                 자두빛 면 위에 앉는다 — 하늘색 글자를 그대로 두면 1.7:1 로 사실상
                 안 보인다. 면 위의 글자색으로 맞춘다. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/sync_retry_button"
                style="@style/Widget.KidCare.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="@string/schedule_sync_retry"
                android:textColor="?attr/colorOnErrorContainer" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/schedule_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/schedule_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/schedule_empty"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="@dimen/edge"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:text="@string/schedule_add"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="22dp" />
    </LinearLayout>

    <!-- ================================ 편집 판 ================================ -->
    <!-- 배경을 깔아 두는 이유: 아래 목록 판을 GONE 으로 감추긴 하지만, 배경이 없으면
         테마에 따라 뒤가 비쳐 보이는 기기가 있다. 큰 글꼴에서도 저장 버튼이 잘리지
         않도록 ScrollView 로 감쌌다(fragment_control.xml 과 같은 이유). -->
    <ScrollView
        android:id="@+id/editor_pane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/edge"
            android:paddingVertical="16dp">

            <TextView
                android:id="@+id/editor_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/schedule_editor_days_label"
                android:textColor="@color/ink"
                android:textSize="15sp" />
            <!-- 요일 일곱. 여백은 칸 **사이**에만 준다 — 낱개마다 좌우 여백을 주면
                 첫 칸이 안으로 밀려 아래 줄들과 왼쪽 선이 어긋난다.

                 saveEnabled=false 인 이유: MaterialButton 이 자기 checked 상태를 스스로
                 복원하는데 이 화면은 editorDays 필드가 유일한 정답이라, 두 복원이
                 부딪히면 화면과 저장될 값이 어긋난다. -->
            <LinearLayout
                android:id="@+id/day_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/day_mon"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="0dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="0dp"
                    android:saveEnabled="false"
                    android:text="@string/schedule_day_mon"
                    android:textColor="@color/day_chip_text"
                    android:textSize="15sp"
                    app:backgroundTint="@color/day_chip_bg"
                    app:shapeAppearance="@style/ShapeAppearance.KidCare.Pill"
                    app:strokeColor="@color/day_chip_stroke"
                    app:strokeWidth="1.5dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/day_tue"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="0dp"
                    android:saveEnabled="false"
                    android:text="@string/schedule_day_tue"
                    android:textColor="@color/day_chip_text"
                    android:textSize="15sp"
                    app:backgroundTint="@color/day_chip_bg"
                    app:shapeAppearance="@style/ShapeAppearance.KidCare.Pill"
                    app:strokeColor="@color/day_chip_stroke"
                    app:strokeWidth="1.5dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/day_wed"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="0dp"
                    android:saveEnabled="false"
                    android:text="@string/schedule_day_wed"
                    android:textColor="@color/day_chip_text"
                    android:textSize="15sp"
                    app:backgroundTint="@color/day_chip_bg"
                    app:shapeAppearance="@style/ShapeAppearance.KidCare.Pill"
                    app:strokeColor="@color/day_chip_stroke"
                    app:strokeWidth="1.5dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/day_thu"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="0dp"
                    android:saveEnabled="false"
                    android:text="@string/schedule_day_thu"
                    android:textColor="@color/day_chip_text"
                    android:textSize="15sp"
                    app:backgroundTint="@color/day_chip_bg"
                    app:shapeAppearance="@style/ShapeAppearance.KidCare.Pill"
                    app:strokeColor="@color/day_chip_stroke"
                    app:strokeWidth="1.5dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/day_fri"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="0dp"
                    android:saveEnabled="false"
                    android:text="@string/schedule_day_fri"
                    android:textColor="@color/day_chip_text"
                    android:textSize="15sp"
                    app:backgroundTint="@color/day_chip_bg"
                    app:shapeAppearance="@style/ShapeAppearance.KidCare.Pill"
                    app:strokeColor="@color/day_chip_stroke"
                    app:strokeWidth="1.5dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/day_sat"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="0dp"
                    android:saveEnabled="false"
                    android:text="@string/schedule_day_sat"
                    android:textColor="@color/day_chip_text_sat"
                    android:textSize="15sp"
                    app:backgroundTint="@color/day_chip_bg"
                    app:shapeAppearance="@style/ShapeAppearance.KidCare.Pill"
                    app:strokeColor="@color/day_chip_stroke"
                    app:strokeWidth="1.5dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/day_sun"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="0dp"
                    android:saveEnabled="false"
                    android:text="@string/schedule_day_sun"
                    android:textColor="@color/day_chip_text_sun"
                    android:textSize="15sp"
                    app:backgroundTint="@color/day_chip_bg"
                    app:shapeAppearance="@style/ShapeAppearance.KidCare.Pill"
                    app:strokeColor="@color/day_chip_stroke"
                    app:strokeWidth="1.5dp" />
            </LinearLayout>

            <!-- 요일을 하나도 안 고른 채 저장하려 했을 때만 보인다. -->
            <TextView
                android:id="@+id/editor_days_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/schedule_editor_days_required"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/schedule_editor_time_label"
                android:textColor="@color/ink"
                android:textSize="15sp" />
            <!-- 시각 두 칸. 버튼 안의 시계 그림을 뺐다 — 바로 위 머리말이 이미
                 "몇 시부터 몇 시까지"라고 말하고 있어서 같은 뜻이 두 번 나왔고,
                 그림+글자 뭉치가 가운데 정렬되는 바람에 두 칸의 숫자가 서로 다른
                 자리에서 시작했다. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/start_time_button"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="0dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:textColor="@color/on_apricot_soft"
                    android:textSize="18sp"
                    app:backgroundTint="@color/apricot_soft"
                    app:shapeAppearance="@style/ShapeAppearance.KidCare.Medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:text="@string/schedule_range_separator"
                    android:textColor="@color/ink_soft"
                    android:textSize="18sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/end_time_button"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="0dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:textColor="@color/on_apricot_soft"
                    android:textSize="18sp"
                    app:backgroundTint="@color/apricot_soft"
                    app:shapeAppearance="@style/ShapeAppearance.KidCare.Medium" />
            </LinearLayout>

            <!-- "다음 날 아침까지"·"하루 종일"처럼 시각 두 개만 봐서는 알 수 없는 것을
                 글자로 말해준다. 평소(같은 날 안에서 끝나는 규칙)에는 GONE. -->
            <TextView
                android:id="@+id/range_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/schedule_editor_mode_label"
                android:textColor="@color/ink"
                android:textSize="15sp" />
            <!-- 고른 모드의 색은 목록 줄의 스티커 색과 같다(ScheduleText.modeLook).
                 고를 때 본 색과 그림이 목록에 그대로 나와야 "내가 정한 그것"으로 읽힌다. -->
            <LinearLayout
                android:id="@+id/mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/schedule_mode_normal"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="0dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="2dp"
                    android:saveEnabled="false"
                    android:text="@string/schedule_mode_normal"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_bell_ring"
                    app:iconGravity="top"
                    app:iconPadding="3dp"
                    app:iconSize="22dp"
                    app:shapeAppearance="@style/ShapeAppearance.KidCare.Medium"
                    app:strokeWidth="1.5dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/schedule_mode_vibrate"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="2dp"
                    android:saveEnabled="false"
                    android:text="@string/schedule_mode_vibrate"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_phone_shake"
                    app:iconGravity="top"
                    app:iconPadding="3dp"
                    app:iconSize="22dp"
                    app:shapeAppearance="@style/ShapeAppearance.KidCare.Medium"
                    app:strokeWidth="1.5dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/schedule_mode_silent"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="2dp"
                    android:saveEnabled="false"
                    android:text="@string/schedule_mode_silent"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_bell_off"
                    app:iconGravity="top"
                    app:iconPadding="3dp"
                    app:iconSize="22dp"
                    app:shapeAppearance="@style/ShapeAppearance.KidCare.Medium"
                    app:strokeWidth="1.5dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/editor_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/editor_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 취소는 글자 버튼이라 자기 왼쪽 여백만큼 안으로 들어가 있었다(214px).
                 외곽선 버튼으로 바꿔 두 칸이 같은 격자에 앉게 했다. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editor_cancel_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:text="@string/schedule_editor_cancel"
                    android:textColor="@color/ink_soft"
                    android:textSize="16sp"
                    app:strokeColor="@color/line_soft"
                    app:strokeWidth="1.5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editor_save_button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:text="@string/schedule_editor_save"
                    android:textSize="16sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
