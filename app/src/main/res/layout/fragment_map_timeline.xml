<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:clipChildren="false">

    <com.naver.maps.map.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/status_card"
        style="@style/Widget.KidCare.Card.Floating"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="top"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/child_avatar"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_avatar_ring"
                android:contentDescription="@string/map_child_avatar"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/mascot_3d" />

            <LinearLayout
                android:id="@+id/map_child_selector"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/child_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/child_default_name"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/sky" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:background="@color/line_soft" />

            <LinearLayout
                android:id="@+id/status_details"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_battery"
                    app:tint="@color/grass" />

                <TextView
                    android:id="@+id/status_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/ink_soft" />

                <ProgressBar
                    android:id="@+id/locate_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/live_tracking_button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="184dp"
        android:contentDescription="@string/map_live_start"
        android:fontFamily="sans-serif-medium"
        android:minHeight="0dp"
        android:text="@string/map_live_start"
        android:textAllCaps="false"
        android:textColor="@color/on_accent"
        android:textSize="14sp"
        app:backgroundTint="@color/sky"
        app:cornerRadius="24dp"
        app:elevation="5dp"
        app:icon="@drawable/ic_map_crosshair"
        app:iconGravity="textStart"
        app:iconPadding="7dp"
        app:iconSize="20dp"
        app:iconTint="@color/on_accent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/locate_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="120dp"
        android:clickable="true"
        android:contentDescription="@string/map_locate_now"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:cardBackgroundColor="@color/paper_card"
        app:cardCornerRadius="26dp"
        app:cardElevation="5dp"
        app:strokeColor="@color/line_soft"
        app:strokeWidth="1dp">

        <!-- MaterialButton에 빈 텍스트와 아이콘만 넣으면 아이콘이 텍스트 시작점 기준으로
             계산돼 왼쪽으로 밀릴 수 있다. 독립 ImageView를 정중앙에 둬 위치를 고정한다. -->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_map_crosshair"
            app:tint="@color/sky" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/timeline_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardBackgroundColor="@color/paper_card"
        app:cardElevation="10dp"
        app:shapeAppearance="@style/ShapeAppearance.KidCare.BottomSheet"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 보라색 선 자체는 5dp지만 이 28dp 영역 전체가 손잡이다. 얇은 선만
                 터치 대상으로 두면 손가락으로 잡기 어려워 실제 드래그가 거의 안 된다. -->
            <FrameLayout
                android:id="@+id/timeline_drag_handle"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:clickable="true"
                android:contentDescription="@string/timeline_drag_handle"
                android:focusable="true">

                <View
                    android:layout_width="42dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_timeline_handle"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_route_icon"
                    android:importantForAccessibility="no"
                    android:padding="9dp"
                    android:src="@drawable/ic_route"
                    app:tint="@color/sky" />

                <TextView
                    android:id="@+id/route_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="@string/timeline_summary_empty"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/ink" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/route_visibility_button"
                    style="@style/Widget.KidCare.Button.Text"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@string/timeline_hide_all_routes"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text=""
                    app:icon="@drawable/ic_visibility"
                    app:iconPadding="0dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/sky" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/timeline_toggle_button"
                    style="@style/Widget.KidCare.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:contentDescription="@string/timeline_expand"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:text="@string/timeline_view_records"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_expand_more"
                    app:iconGravity="textEnd"
                    app:iconPadding="4dp"
                    app:iconSize="18dp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/timeline_content"
                android:layout_width="match_parent"
                android:layout_height="174dp"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/timeline_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp" />

                <TextView
                    android:id="@+id/timeline_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/timeline_empty"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/prev_day_button"
                    style="@style/Widget.KidCare.Button.Text"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/day_prev"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text=""
                    app:icon="@drawable/ic_chevron_left"
                    app:iconPadding="0dp"
                    app:iconTint="@color/sky" />

                <TextView
                    android:id="@+id/day_header"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_date_pill"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/sky" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/next_day_button"
                    style="@style/Widget.KidCare.Button.Text"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/day_next"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text=""
                    app:icon="@drawable/ic_chevron_right"
                    app:iconPadding="0dp"
                    app:iconTint="@color/sky" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
