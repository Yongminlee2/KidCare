<?xml version="1.0" encoding="utf-8"?>
<!-- 관리 탭. 부모가 버튼 하나로 아이 폰을 바꾸는 화면이라 버튼을 크게 두고,
     누른 뒤 무슨 일이 벌어졌는지를 맨 아래 한 줄이 계속 말해준다.
     작은 화면·큰 글꼴 설정에서도 아래쪽 버튼이 잘리지 않도록 ScrollView 로 감쌌다.

     소리 모드 버튼 셋을 채운 버튼에서 토널로 내렸다. 셋 다 진한 하늘색이면 화면에
     "지금 눌러야 할 것"이 셋으로 보이는데, 실제로 이 셋은 서로 대등한 선택지고
     이 화면에서 진짜 강한 동작은 아래쪽 핸드폰 찾기 하나뿐이다. 색의 세기로
     그 위계를 말한다. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/edge"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tab_control"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="@string/control_header_subtitle"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- 아이 폰이 아직 안 붙었거나 상태를 못 읽을 때만 보인다. 평소에는 GONE. -->
        <TextView
            android:id="@+id/child_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/control_section_network"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <!-- 보기만 한다. 끄고 켜기는 안드로이드가 서드파티 앱에 허용하지 않는다
             (child/NetworkState 주석). 그 사실을 카드 안에 적어 두는 이유는, 안 적으면
             "왜 스위치가 없지"가 계속 질문으로 돌아오기 때문이다. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/sky_soft"
            app:shapeAppearance="@style/ShapeAppearance.KidCare.Small"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:id="@+id/network_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wifi"
                    app:tint="@color/sky" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/network_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/control_network_unknown"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/network_wifi_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/control_network_readonly"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/control_section_ringer"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/grass_soft"
            app:shapeAppearance="@style/ShapeAppearance.KidCare.Small"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/ringer_state_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_volume_up"
                    app:tint="@color/grass" />

                <TextView
                    android:id="@+id/ringer_state"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:text="@string/control_ringer_status_loading"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/ink" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ringer_refresh_button"
                    style="@style/Widget.KidCare.Button.Text"
                    android:layout_width="92dp"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/control_ringer_refresh"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_refresh"
                    app:iconGravity="textStart"
                    app:iconPadding="2dp"
                    app:iconSize="17dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 방해 금지가 켜져 있을 때만 보인다. 안 적으면 부모가 위의 "무음"을
             아이가 바꾼 것으로 읽는다(child/RingerController.dndState 주석). -->
        <TextView
            android:id="@+id/ringer_dnd_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/control_ringer_dnd_note"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- 폭이 셋으로 갈리므로 글자를 두 줄(그림 / 이름)로 둔다. 한 줄로 두면
                 큰 글꼴 설정에서 말줄임(…)으로 잘려 무슨 버튼인지 알 수 없어진다. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/mode_normal_button"
                style="@style/Widget.KidCare.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="8dp"
                android:text="@string/control_mode_normal"
                app:strokeWidth="0dp"
                app:icon="@drawable/ic_volume_up"
                app:iconGravity="textTop"
                app:iconPadding="4dp"
                app:iconSize="22dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mode_vibrate_button"
                style="@style/Widget.KidCare.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="8dp"
                android:text="@string/control_mode_vibrate"
                app:strokeWidth="0dp"
                app:icon="@drawable/ic_vibration"
                app:iconGravity="textTop"
                app:iconPadding="4dp"
                app:iconSize="22dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mode_silent_button"
                style="@style/Widget.KidCare.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="8dp"
                android:text="@string/control_mode_silent"
                app:strokeWidth="0dp"
                app:icon="@drawable/ic_volume_off"
                app:iconGravity="textTop"
                app:iconPadding="4dp"
                app:iconSize="22dp" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/lock_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="@string/control_lock_switch"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/control_lock_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="?attr/colorOutlineVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/find_button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/control_find_phone"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/on_berry"
            app:backgroundTint="@color/berry"
            app:icon="@drawable/ic_find_phone"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="24dp"
            app:iconTint="@color/on_berry" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/control_find_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- 앱을 새로 열었을 때는 아이 폰이 울리고 있는지 알 방법이 없다.
             그래서 '찾기' 버튼과 별개로 언제든 끌 수 있는 길을 하나 열어둔다
             (ControlFragment.renderFindButton 주석 참고). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/find_stop_button"
            style="@style/Widget.KidCare.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/control_find_stop_hint" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- 한마디 보내기. 부모가 걸어가면서 한 손으로 쓰는 자리라 칩이 입력칸보다
             먼저 눈에 들어와야 하지만, 칩을 누르는 즉시 보내지는 않는다 — 잘못 누른
             한 줄은 되돌릴 수 없다(아이 폰 화면에 이미 떴다). 칩은 입력칸을 채우고,
             보내는 것은 아래 큰 버튼 하나가 한다. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/control_section_message"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/message_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <!-- checkable=false: 칩은 고르는 것이 아니라 입력칸을 채우는 단추다.
                 켜진 채로 남으면 "이 문장이 선택됨"으로 읽힌다. -->
            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:text="@string/control_message_chip_where" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:text="@string/control_message_chip_call" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:text="@string/control_message_chip_come_home" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:text="@string/control_message_chip_meal" />
        </com.google.android.material.chip.ChipGroup>

        <!-- counterEnabled 로 몇 자를 썼는지 항상 보여준다. maxLength 로 100자에서
             입력이 멈추는데, 그때 화면에 '100/100'이 떠 있으므로 부모는 왜 더 안
             써지는지 알 수 있다 — 보낼 때 조용히 잘라내는 것과 다르다. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/message_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/control_message_hint"
            app:counterEnabled="true"
            app:counterMaxLength="100">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/message_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textShortMessage|textMultiLine|textCapSentences"
                android:maxLength="100"
                android:maxLines="3"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/message_send_button"
            style="@style/Widget.KidCare.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:text="@string/control_message_send"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="22dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/control_message_hint_detail"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- 알람 맞추기. 시각은 MaterialTimePicker 로만 고르게 한다 — 숫자로 입력하게
             하면 0~1439 밖의 값이 생길 수 있고, 애초에 부모가 한 손으로 못 쓴다.
             '지금 걸려 있는 알람' 줄이 이 구역 맨 위에 있는 이유: 부모가 이 화면에
             들어와서 가장 먼저 확인해야 하는 것이 "이미 걸어뒀나?"다. 안 보이면
             세 개를 건다. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/control_section_alarm"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <!-- 걸어 둔 알람이 없으면 GONE. -->
        <TextView
            android:id="@+id/alarm_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alarm_time_button"
            style="@style/Widget.KidCare.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:icon="@drawable/ic_alarm"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="22dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/alarm_label_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/control_alarm_label_hint">

            <!-- 20자면 아이 폰 알림 제목 한 줄이다. 더 긴 문장은 '한마디 보내기'가
                 할 일이라 여기서 늘리지 않는다. -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/alarm_label_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textShortMessage|textCapSentences"
                android:maxLength="20"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alarm_set_button"
            style="@style/Widget.KidCare.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:text="@string/control_alarm_set"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:icon="@drawable/ic_alarm"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="22dp" />

        <!-- 폰찾기의 '이미 울리고 있다면 소리 끄기'와 같은 자리·같은 이유로 항상 살아
             있다. 부모 폰의 기억이 만료됐거나 다른 폰에서 걸었어도 여기서 끌 수 있어야
             한다 — 취소 명령은 걸린 알람이 없을 때 와도 아이 폰에서 조용히 지나간다. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/alarm_cancel_button"
            style="@style/Widget.KidCare.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/control_alarm_cancel" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/control_alarm_hint_detail"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/command_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/command_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
