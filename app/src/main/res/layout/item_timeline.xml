<?xml version="1.0" encoding="utf-8"?>
<!--
    하루 요약 한 줄.

    ## 이모지냐 그린 아이콘이냐

    이모지로 간다. 이 앱은 이미 이모지로 말하고 있다 — 관리 탭의 🔔📳🔕, 핸드폰
    찾기의 📢, 지도 카드의 🔋, 연결 끊김 배너의 ⚠️. 여기만 벡터 아이콘으로 바꾸면
    한 앱 안에 그림 언어가 둘이 되고, 나머지를 전부 벡터로 바꾸려면 코드가 문자열
    대신 아이콘을 고르게 되어(TimelineAdapter, ControlFragment) 문구를 strings.xml
    한 곳에서 고친다는 규율이 깨진다. 색종이·알림장 스티커라는 방향과도 이모지 쪽이
    더 가깝다.

    대신 이모지를 맨바닥에 두지 않고 동그란 색면 위에 올린다(bg_sticker). 지름이
    일정한 원이 줄마다 같은 자리에 서면 목록이 세로로 정렬돼 하루 흐름이 잡힌다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/icon_text"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_sticker"
        android:gravity="center"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/detail_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</LinearLayout>
