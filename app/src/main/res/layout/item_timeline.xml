<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="132dp"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="5dp"
    android:layout_marginVertical="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/paper_card"
    app:cardElevation="2dp"
    app:shapeAppearance="@style/ShapeAppearance.KidCare.Large"
    app:strokeColor="@color/line_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/icon_text"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_route_icon"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_route"
            app:tint="@color/sky" />

        <TextView
            android:id="@+id/title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/detail_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/route_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_date_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="@string/timeline_route_visible"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/sky"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
