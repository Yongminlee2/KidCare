<?xml version="1.0" encoding="utf-8"?>
<!--
    하단 탭 '장소'(핀). 색 처리는 다른 탭 아이콘과 같다 — 검정으로 그려두면
    BottomNavigationView 가 선택 상태에 맞춰 틴트한다.

    지도 탭이 이미 '펼친 지도'라 장소는 핀 하나로 갈랐다. 테두리만 남기고 속을 비운
    것은 다른 셋(지도·관리·예약)이 전부 선 그림이라 혼자 꽉 찬 덩어리가 되면 튀기
    때문이다. 안쪽 구멍은 evenOdd 로 뚫는다(ic_tab_schedule 과 같은 수법).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 물방울 모양 핀. 바깥 윤곽에서 안쪽 윤곽을 빼 테두리만 남긴다. -->
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M12,2 C8.13,2 5,5.13 5,9 C5,14.25 12,22 12,22 C12,22 19,14.25 19,9 C19,5.13 15.87,2 12,2 Z M12,4 C14.76,4 17,6.24 17,9 C17,12.4 12.9,17.9 12,19.06 C11.1,17.9 7,12.4 7,9 C7,6.24 9.24,4 12,4 Z" />

    <!-- 가운데 점. 핀 안이 완전히 비면 24dp 에서 그냥 빈 물방울로 보인다. -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M12,6.6 a2.4,2.4 0 1,0 0,4.8 a2.4,2.4 0 1,0 0,-4.8 Z" />
</vector>
