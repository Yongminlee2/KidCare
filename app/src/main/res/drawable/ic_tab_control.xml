    <path
        android:fillColor="#FF000000"
        android:pathData="M12,4 C8.7,4 6,6.7 6,10 v3.3 L4.6,15.9 C4.2,16.6 4.7,17.5 5.5,17.5 h13 c0.8,0 1.3,-0.9 0.9,-1.6 L18,13.3 V10 C18,6.7 15.3,4 12,4 Z" />

