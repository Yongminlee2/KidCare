<?xml version="1.0" encoding="utf-8"?>
<!--
    하단 탭 '관리'. 색 처리는 ic_tab_map 과 같다.

    조절 손잡이(슬라이더) 대신 종을 그렸다. 이 탭이 실제로 하는 일이 벨소리·진동·
    무음 바꾸기와 핸드폰 찾기 — 전부 소리다. 슬라이더는 "설정 어딘가"라는 뜻밖에
    없는데다, 가는 선 여러 개라 24dp 에서 이 팔레트의 굵은 맛과 어긋났다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
