<?xml version="1.0" encoding="utf-8"?>
<!--
    하단 탭 '알림'. 색 처리는 다른 탭 아이콘과 같다 — 검정으로 그려두면
    BottomNavigationView 가 선택 상태에 맞춰 틴트한다.

    **종을 쓸 수 없다.** ic_tab_control 이 이미 종이다(그 탭이 하는 일이 전부 소리라
    그렇게 골랐다). 같은 띠에 종이 둘이면 부모는 어느 쪽이 무엇인지 매번 다시 읽어야
    한다. 그래서 여기는 '줄 세 개(목록) + 새것 표시 점'으로 갔다 — 이 탭이 실제로
    보여주는 것이 사건 목록이고, 점 하나가 '안 읽은 게 있다'를 그대로 말한다.

    첫 줄만 짧은 이유는 점과 부딪히지 않게 하려는 것이다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 목록 세 줄 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M4,7 L12.5,7 M4,12 L17,12 M4,17 L17,17"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- 새것 표시 -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M17.8,7 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0 Z" />
</vector>
