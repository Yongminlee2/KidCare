<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- 무음·진동 전환은 방해 금지 정책을 건드리는 일이라 별도 권한이 필요하다.
         이 권한은 매니페스트 선언만으로는 부여되지 않는다 — 사람이 설정 목록
         화면(ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS)에서 직접 켜야 한다. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- 폰찾기 전체화면 알림에 쓴다. 안드로이드 14(API 34)부터는 전화·알람 앱이
         아니면 이 권한이 자동 승인되지 않는다 — FindPhoneController 는 이걸
         전제하지 않고, 소리·진동은 이 권한과 무관하게 알람 스트림으로 울린다. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 예약 규칙 경계(Task 8)에 정확히 맞춰 소리 모드를 바꾸는 데 쓴다. API 31+ 는
         정확한 알람에 SCHEDULE_EXACT_ALARM(사람이 설정에서 켜야 함) 또는
         USE_EXACT_ALARM 이 필요한데, 이 앱은 사용자가 지정한 시각에 소리를 바꾸는
         것이 핵심 기능이라 USE_EXACT_ALARM 용도에 맞고 별도 승인 절차 없이 부여된다.
         ScheduleApplier 는 그래도 AlarmManager.canScheduleExactAlarms() 를 매번 다시
         확인하고, false 면 부정확한 알람으로 물러나며 그 사실을 로그에 남긴다. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:name=".KidCareApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KidCare">

        <activity
            android:name=".RouterActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".onboarding.RoleSelectActivity" android:exported="false" />
        <activity android:name=".onboarding.GuardianPairingActivity" android:exported="false" />
        <activity android:name=".onboarding.ChildPairingActivity" android:exported="false" />
        <activity android:name=".onboarding.PermissionActivity" android:exported="false" />
        <activity android:name=".guardian.GuardianMainActivity" android:exported="false" />
        <activity android:name=".child.ChildHomeActivity" android:exported="false" />
        <!-- 알림의 전체화면 인텐트·중지 액션이 여는 화면. 시스템(우리 앱이 스스로
             건 PendingIntent)만 열 수 있으면 되므로 exported=false. 최근 앱
             목록에는 안 남긴다(excludeFromRecents) — 아이가 나중에 최근 앱에서
             다시 열어 헷갈릴 이유가 없다. singleTask 로 둬 알림을 여러 번 눌러도
             인스턴스가 하나만 남는다. -->
        <activity
            android:name=".child.FindPhoneActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true" />

        <service
            android:name=".child.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".child.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ActivityRecognitionClient 의 전환 이벤트를 받는다. 시스템(구글 플레이
             서비스)만 이 PendingIntent 로 브로드캐스트를 보내므로 exported=false. -->
        <receiver
            android:name=".child.ActivityTransitionReceiver"
            android:exported="false" />

        <!-- 예약 경계 알람(ScheduleApplier 가 코드로 거는 PendingIntent)과 재부팅·
             시각변경·시간대변경을 받아 규칙을 다시 적용한다(Task 8). 셋 다 시스템만
             보낼 수 있는 보호된 브로드캐스트라 exported=true 로 열어도 다른 앱이
             흉내낼 수 없다 — BOOT_COMPLETED 는 애초에 exported=false 로는 받을
             방법이 없다(BootReceiver 와 같은 이유). -->
        <receiver
            android:name=".child.ScheduleAlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
