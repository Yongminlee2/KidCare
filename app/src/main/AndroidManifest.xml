<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 보호자 폰의 알림 상시 수신(AlertService). 왜 dataSync 가 아니라 specialUse 인지는
         그 클래스 주석에 적었다 — 요약하면 안드로이드 15부터 dataSync 는 하루 6시간만
         돌 수 있어서, 나머지 18시간 동안 알림이 조용히 안 오게 된다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- 무음·진동 전환은 방해 금지 정책을 건드리는 일이라 별도 권한이 필요하다.
         이 권한은 매니페스트 선언만으로는 부여되지 않는다 — 사람이 설정 목록
         화면(ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS)에서 직접 켜야 한다. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- 폰찾기 전체화면 알림에 쓴다. 안드로이드 14(API 34)부터는 전화·알람 앱이
         아니면 이 권한이 자동 승인되지 않는다 — FindPhoneController 는 이걸
         전제하지 않고, 소리·진동은 이 권한과 무관하게 알람 스트림으로 울린다. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 예약 규칙 경계(Task 8)에 정확히 맞춰 소리 모드를 바꾸고, 부모가 맞춘 알람시계를
         제 시각에 울리는 데(5단계 Task 6, RemoteAlarmController) 쓴다. API 31+ 는
         정확한 알람에 SCHEDULE_EXACT_ALARM(사람이 설정에서 켜야 함) 또는
         USE_EXACT_ALARM 이 필요한데, 이 앱은 사용자가 지정한 시각에 소리를 바꾸는
         것이 핵심 기능이라 USE_EXACT_ALARM 용도에 맞고 별도 승인 절차 없이 부여된다.
         ScheduleApplier 는 그래도 AlarmManager.canScheduleExactAlarms() 를 매번 다시
         확인하고, false 면 부정확한 알람으로 물러나며 그 사실을 로그에 남긴다. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 핸드폰 찾기가 진동으로도 울리는 데 쓴다. 설치할 때 자동으로 부여되는
         권한이라 사용자에게 물어볼 일이 없고, 그래서 빠뜨려도 빌드는 멀쩡히
         통과한다 — 실기기에서 폰찾기가 SecurityException 으로 실패하고 나서야
         드러났다. 벨소리가 없거나 준비에 실패하면 진동만으로 울리는 갈래
         (FindPhoneController)가 있어서, 이게 없으면 그 갈래는 통째로 죽는다. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".KidCareApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KidCare">

        <activity
            android:name=".RouterActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".onboarding.RoleSelectActivity" android:exported="false" />
        <activity android:name=".onboarding.GuardianPairingActivity" android:exported="false" />
        <activity android:name=".onboarding.ChildPairingActivity" android:exported="false" />
        <activity android:name=".onboarding.PermissionActivity" android:exported="false" />
        <activity android:name=".guardian.GuardianMainActivity" android:exported="false" />
        <activity android:name=".child.ChildHomeActivity" android:exported="false" />
        <!-- 알림의 전체화면 인텐트·중지 액션이 여는 화면. 시스템(우리 앱이 스스로
             건 PendingIntent)만 열 수 있으면 되므로 exported=false. 최근 앱
             목록에는 안 남긴다(excludeFromRecents) — 아이가 나중에 최근 앱에서
             다시 열어 헷갈릴 이유가 없다. singleTask 로 둬 알림을 여러 번 눌러도
             인스턴스가 하나만 남는다. -->
        <activity
            android:name=".child.FindPhoneActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true" />
        <!-- 부모가 보낸 한마디를 띄우는 화면(5단계 Task 5). exported·launchMode·
             excludeFromRecents 는 위 FindPhoneActivity 와 같은 이유로 같은 값이다.
             다른 점은 **없는 것**에 있다: 잠금화면 관련 속성
             (showOnLockScreen / turnScreenOn)을 하나도 두지 않았고 코드에서도
             setShowWhenLocked·setTurnScreenOn 을 부르지 않는다. 폰찾기는 잃어버린 폰을
             깨워야 하지만 메시지는 아이가 폰을 집을 때까지 기다려도 되는 일이다 —
             잠긴 폰에서는 알림줄에 남아 있다가 폰을 열 때 보인다. -->
        <activity
            android:name=".child.MessageActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true" />

        <service
            android:name=".child.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 보호자 폰에서 events/ 를 상시 구독하는 서비스(5단계 Task 4). FCM 이 없어
             아이 폰이 부모 폰을 깨울 방법이 없다는 것이 이 서비스의 존재 이유다.
             기본값은 꺼짐이고 부모가 알림 탭에서 켠다. -->
        <service
            android:name=".guardian.AlertService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- API 34+ 는 specialUse 를 쓸 때 무슨 용도인지 문자열로 밝히기를 요구한다. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="firestore_event_listener_without_fcm" />
        </service>

        <!-- 부모가 맞춘 알람이 우는 5분 동안만 사는 서비스(5단계 whole-branch 리뷰).
             매니페스트 리시버 하나에서 시작되는 알람이라, 이게 없으면 위치 권한이 꺼져
             TrackingService 가 안 뜨는 폰에서 포그라운드 컴포넌트가 하나도 없는 채로
             5분을 울리게 된다 — 시스템이 회수하면 소리가 조용히 끊긴다. specialUse 를
             고른 이유(shortService 3분 상한, mediaPlayback 은 미디어가 아님)는 그 클래스
             주석에 있다. -->
        <service
            android:name=".child.RemoteAlarmService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="parent_set_alarm_clock_ringing" />
        </service>

        <receiver
            android:name=".child.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ActivityRecognitionClient 의 전환 이벤트를 받는다. 시스템(구글 플레이
             서비스)만 이 PendingIntent 로 브로드캐스트를 보내므로 exported=false. -->
        <receiver
            android:name=".child.ActivityTransitionReceiver"
            android:exported="false" />

        <!-- 예약 경계 알람(ScheduleApplier 가 코드로 거는 PendingIntent)과 재부팅·
             시각변경·시간대변경을 받아 규칙을 다시 적용한다(Task 8). 셋 다 시스템만
             보낼 수 있는 보호된 브로드캐스트라 exported=true 로 열어도 다른 앱이
             흉내낼 수 없다 — BOOT_COMPLETED 는 애초에 exported=false 로는 받을
             방법이 없다(BootReceiver 와 같은 이유). -->
        <receiver
            android:name=".child.ScheduleAlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 부모가 맞춘 알람이 울 시각과, 아이가 '알람 끄기'를 누른 신호를 받는다
             (5단계 Task 6). 둘 다 우리 앱이 스스로 만든 PendingIntent 로만 오므로
             exported=false. 재부팅·시각변경 재등록을 여기에 두지 않은 이유는
             ScheduleAlarmReceiver 쪽 주석 참고 — BOOT_COMPLETED 를 받는 문이 하나
             더 늘면 "부팅 뒤에 무엇을 다시 거는가"가 파일 셋으로 갈라진다. -->
        <receiver
            android:name=".child.RemoteAlarmReceiver"
            android:exported="false" />

        <!-- 장소 지오펜스 전환(5단계 Task 3). ActivityTransitionReceiver 와 같은 이유로
             exported=false — 우리가 만든 PendingIntent 로 플레이 서비스만 보낸다.
             여기서 이벤트를 직접 쓰지 않고 판정기로 넘기는 이유는 그 클래스 주석 참고. -->
        <receiver
            android:name=".child.PlaceGeofenceReceiver"
            android:exported="false" />
    </application>
</manifest>
